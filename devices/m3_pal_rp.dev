device p16rp4
powerup reset
descr P16RP4
partname p16rp4 PAL16RP4
pins 20
power 10 20
fuses 2056
array 32 64
clock 1
oepin 11
lines p2 f19 p3 f18 p4 f17 p5 f16 p6 f15 p7 f14 p8 f13 p9 f12
mc 12 gen sum=57-63 oe=56 polfuse=2055 polhi=1 reg=0
mc 13 gen sum=49-55 oe=48 polfuse=2054 polhi=1 reg=0
mc 14 gen sum=40-47 polfuse=2053 polhi=1 oe=pin reg=1 pold=1
mc 15 gen sum=32-39 polfuse=2052 polhi=1 oe=pin reg=1 pold=1
mc 16 gen sum=24-31 polfuse=2051 polhi=1 oe=pin reg=1 pold=1
mc 17 gen sum=16-23 polfuse=2050 polhi=1 oe=pin reg=1 pold=1
mc 18 gen sum=9-15 oe=8 polfuse=2049 polhi=1 reg=0
mc 19 gen sum=1-7 oe=0 polfuse=2048 polhi=1 reg=0
refdefect kbnoflip      # B001
end

