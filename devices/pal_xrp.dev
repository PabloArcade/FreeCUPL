# PAL22XP10: combinational, small sum XOR big sum.
device p22xp10
descr PAL22XP10
partname p22xp10 PAL22XP10
pins 24
power 12 24
fuses 3970
array 44 90
lines p2 p1 p3 f22 p4 f21 p5 f20 p6 f19 p7 f18 p8 f17 p9 f16 p10 f15 p11 p13 f23 f14
mc 14 gen sum=84-89 xsum=82-83 xswap=1 oe=81 polfuse=3969 polhi=1 reg=0
mc 15 gen sum=75-80 xsum=73-74 xswap=1 oe=72 polfuse=3968 polhi=1 reg=0
mc 16 gen sum=66-71 xsum=64-65 xswap=1 oe=63 polfuse=3967 polhi=1 reg=0
mc 17 gen sum=57-62 xsum=55-56 xswap=1 oe=54 polfuse=3966 polhi=1 reg=0
mc 18 gen sum=48-53 xsum=46-47 xswap=1 oe=45 polfuse=3965 polhi=1 reg=0
mc 19 gen sum=39-44 xsum=37-38 xswap=1 oe=36 polfuse=3964 polhi=1 reg=0
mc 20 gen sum=30-35 xsum=28-29 xswap=1 oe=27 polfuse=3963 polhi=1 reg=0
mc 21 gen sum=21-26 xsum=19-20 xswap=1 oe=18 polfuse=3962 polhi=1 reg=0
mc 22 gen sum=12-17 xsum=10-11 xswap=1 oe=9 polfuse=3961 polhi=1 reg=0
mc 23 gen sum=3-8 xsum=1-2 xswap=1 oe=0 polfuse=3960 polhi=1 reg=0
refdefect kbnoflip      # B001
end

# PAL22RX8: one XOR row per output (xsum; xone: the first operand when it
# is one term, else the second) and an 8-row sum.
device p22rx8
refdefect combd
descr PAL22RX8
partname p22rx8 PAL22RX8
pins 24
power 12 24
fuses 3616
array 44 82
clock 1
ap 80
ar 81
lines p2 p23 p3 f22 p4 f21 p5 f20 p6 f19 p7 f18 p8 f17 p9 f16 p10 f15 p11 p14 p1 p13
mc 15 gen sum=72-79 xsum=71-71 xone=1 oe=70 pol=l reg=3615 regon=0 fb=pin
mc 16 gen sum=62-69 xsum=61-61 xone=1 oe=60 pol=l reg=3614 regon=0 fb=pin
mc 17 gen sum=52-59 xsum=51-51 xone=1 oe=50 pol=l reg=3613 regon=0 fb=pin
mc 18 gen sum=42-49 xsum=41-41 xone=1 oe=40 pol=l reg=3612 regon=0 fb=pin
mc 19 gen sum=32-39 xsum=31-31 xone=1 oe=30 pol=l reg=3611 regon=0 fb=pin
mc 20 gen sum=22-29 xsum=21-21 xone=1 oe=20 pol=l reg=3610 regon=0 fb=pin
mc 21 gen sum=12-19 xsum=11-11 xone=1 oe=10 pol=l reg=3609 regon=0 fb=pin
mc 22 gen sum=2-9 xsum=1-1 xone=1 oe=0 pol=l reg=3608 regon=0 fb=pin
end
