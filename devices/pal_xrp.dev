# PAL20XRP4/6/8/10.  Registered outputs: D = small sum (2 rows) XOR big
# sum (6 rows); the operand with fewer terms goes to the small sum (xswap);
# polarity before the register.  PAL20XRP4 pin 21: the OE term is left
# false without .OE (refdefect oe0).

device p20xrp4
descr PAL20XRP4
partname p20xrp4 PAL20XRP4
pins 24
power 12 24
fuses 3450
array 40 86
clock 1
oepin 13
lines p2 f23 p3 f22 p4 f21 p5 f20 p6 f19 p7 f18 p8 f17 p9 f16 p10 f15 p11 f14
mc 14 gen sum=78-85 oe=77 polfuse=3449 polhi=1 reg=0
mc 15 gen sum=69-76 oe=68 polfuse=3448 polhi=1 reg=0
mc 16 gen sum=60-67 oe=59 polfuse=3447 polhi=1 reg=0
mc 17 gen sum=53-58 xsum=51-52 xswap=1 polfuse=3446 polhi=1 oe=pin reg=1 pold=1
mc 18 gen sum=45-50 xsum=43-44 xswap=1 polfuse=3445 polhi=1 oe=pin reg=1 pold=1
mc 19 gen sum=37-42 xsum=35-36 xswap=1 polfuse=3444 polhi=1 oe=pin reg=1 pold=1
mc 20 gen sum=29-34 xsum=27-28 xswap=1 polfuse=3443 polhi=1 oe=pin reg=1 pold=1
mc 21 gen sum=19-26 oe=18 polfuse=3442 polhi=1 reg=0
mc 22 gen sum=10-17 oe=9 polfuse=3441 polhi=1 reg=0
mc 23 gen sum=1-8 oe=0 polfuse=3440 polhi=1 reg=0
refdefect oe0 21
refdefect kbnoflip      # B001
end

