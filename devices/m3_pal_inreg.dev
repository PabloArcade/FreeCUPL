# PALs with registered (r, .DQ) or latched (t, .LQ) inputs.  One flag fuse
# per input pin, set when the pin is read directly.
# Generated from probe results; do not edit by hand.

device p19l8r
descr P19L8R
partname p19l8r PAL19L8R (registered inputs)
pins 24
power 12 24
fuses 2443
array 38 64
lines p2 p23 p3 p1 p4 f21 p5 f20 p6 f19 p7 f18 p8 f17 p9 f16 p10 p13 p11
mc 15 gen sum=57-63 oe=56 pol=l reg=0
mc 16 gen sum=49-55 oe=48 pol=l reg=0
mc 17 gen sum=41-47 oe=40 pol=l reg=0
mc 18 gen sum=33-39 oe=32 pol=l reg=0
mc 19 gen sum=25-31 oe=24 pol=l reg=0
mc 20 gen sum=17-23 oe=16 pol=l reg=0
mc 21 gen sum=9-15 oe=8 pol=l reg=0
mc 22 gen sum=1-7 oe=0 pol=l reg=0
inflag 23 2432
inflag 2 2433
inflag 3 2434
inflag 4 2435
inflag 5 2436
inflag 6 2437
inflag 7 2438
inflag 8 2439
inflag 9 2440
inflag 10 2441
inflag 11 2442
inflag dq
end

