# PALs with latched outputs (.L).  The latch enable does not reach the
# array and is taken as the clock pin.
# Generated from probe results; do not edit by hand.

device p1016ld8
# Simulator: no C/K/P on the latch enable; the latches never load.
simdefect noclock
descr P1016LD8
partname p1016ld8 P1016LD8 (latched outputs)
pins 24
power 12 24
fuses 2056
array 32 64
clock 1
oepin 13
lines f5 p23 p2 p22 p3 f21 f4 f17 f8 f20 f7 p15 p10 p14 p11 f18
mc 4 gen sum=8-15 polfuse=2049 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 5 gen sum=24-31 polfuse=2051 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 7 gen sum=40-47 polfuse=2053 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 8 gen sum=56-63 polfuse=2055 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 17 gen sum=48-55 polfuse=2054 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 18 gen sum=32-39 polfuse=2052 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 20 gen sum=16-23 polfuse=2050 polhi=1 oe=pin reg=1 pold=1 latch=1
mc 21 gen sum=0-7 polfuse=2048 polhi=1 oe=pin reg=1 pold=1 latch=1
refdefect kbnoflip      # B001
end

