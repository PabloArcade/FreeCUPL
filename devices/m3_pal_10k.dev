mc 17 gen sum=48-55 polfuse=2054 polhi=0 reg=0
mc 18 gen sum=32-39 polfuse=2052 polhi=0 reg=0
mc 20 gen sum=16-23 polfuse=2050 polhi=0 reg=0
mc 21 gen sum=0-7 polfuse=2048 polhi=0 reg=0
refdefect kbnoflip      # B001
end

