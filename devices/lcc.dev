# SPDX-License-Identifier: GPL-3.0-or-later
# LCC/PLCC packages of the 22V10, GAL16V8/20V8 and PAL16/20 parts: the
# DIP fuse map with the pins renumbered (pinmap OLD=NEW).  NEW=0: the pin
# does not reach the array and was not located.  The cp variants reserve
# pin 5.

device p16l8alcc
inherit p16l8
descr P16L8 in a 28-pin LCC/PLCC package
partname p16l8alcc PAL16L8A (PLCC28)
pins 28
pinmap 1=24 2=25 3=26 4=27 5=28 6=2 7=3 8=4 9=5 10=0 11=7 12=8 13=10 14=12 15=14 16=16 17=18 18=20 19=22 20=0
libtag p16l8alcc DLIB-h-40-9
end

device p16r4alcc
inherit p16r4
descr P16R4 in a 28-pin LCC/PLCC package
partname p16r4alcc PAL16R4A (PLCC28)
pins 28
pinmap 1=0 2=25 3=26 4=27 5=28 6=2 7=3 8=4 9=5 10=0 11=0 12=8 13=10 14=12 15=14 16=16 17=18 18=20 19=22 20=0
libtag p16r4alcc DLIB-h-40-9
end

device p16r6alcc
inherit p16r6
descr P16R6 in a 28-pin LCC/PLCC package
partname p16r6alcc PAL16R6A (PLCC28)
pins 28
pinmap 1=0 2=25 3=26 4=27 5=28 6=2 7=3 8=4 9=5 10=0 11=0 12=8 13=10 14=12 15=14 16=16 17=18 18=20 19=22 20=0
libtag p16r6alcc DLIB-h-40-9
end

device p16r8alcc
