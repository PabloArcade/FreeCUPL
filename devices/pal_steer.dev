# SPDX-License-Identifier: GPL-3.0-or-later
# Product-term steering PALs.  Outputs with the same sum rows share them;
# the steering fuse of shared row j is steer + 2j (1 = the term reaches the
# output).  Rows are given out in strcmp order of the output names.
# steershare 1: a term in both sums is written once, with neither fuse.
# Generated from probe results; do not edit by hand.

device p20s10
descr P20S10 (product-term steering)
partname p20s10 PAL20S10
pins 24
power 12 24
fuses 3322
array 40 80
lines p2 p1 p3 p22 p4 p21 p5 p20 p6 p19 p7 p18 p8 p17 p9 p16 p10 p15 p11 p13
mc 23 gen sum=1-7 oe=0 polfuse=3200 polhi=1 reg=0
mc 22 gen sum=9-22 oe=8 polfuse=3201 polhi=1 reg=0 steer=3211 steerstep=2
mc 21 gen sum=9-22 oe=23 polfuse=3202 polhi=1 reg=0 steer=3210 steerstep=2
mc 20 gen sum=25-38 oe=24 polfuse=3203 polhi=1 reg=0 steer=3239 steerstep=2
mc 19 gen sum=25-38 oe=39 polfuse=3204 polhi=1 reg=0 steer=3238 steerstep=2
mc 18 gen sum=41-54 oe=40 polfuse=3205 polhi=1 reg=0 steer=3267 steerstep=2
mc 17 gen sum=41-54 oe=55 polfuse=3206 polhi=1 reg=0 steer=3266 steerstep=2
mc 16 gen sum=57-70 oe=56 polfuse=3207 polhi=1 reg=0 steer=3295 steerstep=2
mc 15 gen sum=57-70 oe=71 polfuse=3208 polhi=1 reg=0 steer=3294 steerstep=2
mc 14 gen sum=72-78 oe=79 polfuse=3209 polhi=1 reg=0
refdefect kbnoflip      # B001
end

