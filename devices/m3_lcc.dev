# LCC/PLCC packages of the other families.  NEW=0 in a pinmap: pin not
# located.  Generated from probe results; do not edit by hand.

device p1020ev8lcc
inherit p1020ev8
descr P1020EV8 in a 28-pin package
partname p1020ev8lcc P1020EV8 (configurable output macrocells, PLCC28)
pins 28
