# The library has no 24-pin mnemonic of this part.  Feedback select
# fuses 5828..5837 as on the PAL22CV10Z.
device p22cv10lcc
descr PAL22CV10 in a 28-pin package: 22V10 with a feedback select fuse per macrocell
partname p22cv10lcc PAL22CV10 (PLCC28)
pins 28
power 14 28
fuses 5838
array 44 132
clock 1
ar 0
sp 131
lines p2 f27 p3 f26 p4 f25 p5 f24 p6 f23 p7 f21 p9 f20 p10 f19 p11 f18 p12 f17 p13 p16
mc 17 gen sum=123-130 oe=122 polfuse=5826 polhi=1 reg=5827 regon=0 fb=nq fbfuse=5837 fbpin=1 alwaysreg=1 fbxor=1
mc 18 gen sum=112-121 oe=111 polfuse=5824 polhi=1 reg=5825 regon=0 fb=nq fbfuse=5836 fbpin=1 alwaysreg=1 fbxor=1
mc 19 gen sum=99-110 oe=98 polfuse=5822 polhi=1 reg=5823 regon=0 fb=nq fbfuse=5835 fbpin=1 alwaysreg=1 fbxor=1
mc 20 gen sum=84-97 oe=83 polfuse=5820 polhi=1 reg=5821 regon=0 fb=nq fbfuse=5834 fbpin=1 alwaysreg=1 fbxor=1
mc 21 gen sum=67-82 oe=66 polfuse=5818 polhi=1 reg=5819 regon=0 fb=nq fbfuse=5833 fbpin=1 alwaysreg=1 fbxor=1
mc 23 gen sum=50-65 oe=49 polfuse=5816 polhi=1 reg=5817 regon=0 fb=nq fbfuse=5832 fbpin=1 alwaysreg=1 fbxor=1
mc 24 gen sum=35-48 oe=34 polfuse=5814 polhi=1 reg=5815 regon=0 fb=nq fbfuse=5831 fbpin=1 alwaysreg=1 fbxor=1
mc 25 gen sum=22-33 oe=21 polfuse=5812 polhi=1 reg=5813 regon=0 fb=nq fbfuse=5830 fbpin=1 alwaysreg=1 fbxor=1
mc 26 gen sum=11-20 oe=10 polfuse=5810 polhi=1 reg=5811 regon=0 fb=nq fbfuse=5829 fbpin=1 alwaysreg=1 fbxor=1
mc 27 gen sum=2-9 oe=1 polfuse=5808 polhi=1 reg=5809 regon=0 fb=nq fbfuse=5828 fbpin=1 alwaysreg=1 fbxor=1
refdefect kbfbinv       # B002
end

