# The polarity fuse of one output has the other sense than in the
# 24-pin library entry.
device p1016ld4lcc
# Simulator: no C/K/P on the latch enable; the latches never load.
simdefect noclock
descr PLSI1016LD4 in a 28-pin package
partname p1016ld4lcc PLSI1016LD4 (PLCC28)
pins 28
power 14 28
fuses 2056
array 32 64
clock 2
oepin 16
lines f6 p27 p3 p26 p4 f25 f5 f20 f10 f24 f9 p18 p12 p17 p13 f21
mc 5 gen sum=8-15 polfuse=2049 polhi=1 reg=0
mc 6 gen sum=24-31 oe=pin polfuse=2051 polhi=1 reg=1 pold=1 latch=1
mc 9 gen sum=40-47 oe=pin polfuse=2053 polhi=1 reg=1 pold=1 latch=1
mc 10 gen sum=56-63 polfuse=2055 polhi=1 reg=0
mc 20 gen sum=48-55 polfuse=2054 polhi=1 reg=0
mc 21 gen sum=32-39 oe=pin polfuse=2052 polhi=1 reg=1 pold=1 latch=1
mc 24 gen sum=16-23 oe=pin polfuse=2050 polhi=1 reg=1 pold=1 latch=1
mc 25 gen sum=0-7 polfuse=2048 polhi=1 reg=0
refdefect kbnoflip      # B001
end
