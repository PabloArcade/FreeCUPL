device p16h2
descr PAL16H2: 16 inputs, 2 active-high outputs, 8 terms each
partname p16h2 PAL16H2
pins 20
power 10 20
fuses 512
array 32 16
lines p2 p1 p3 p19 p4 p18 p5 p17 p6 p14 p7 p13 p8 p12 p9 p11
mc 16 comb sum=0-7 pol=h
mc 15 comb sum=8-15 pol=h
libtag p16h2 DLIB-h-40-7
end

device p16l2
descr PAL16L2: 16 inputs, 2 active-low outputs, 8 terms each
partname p16l2 PAL16L2
pins 20
power 10 20
fuses 512
array 32 16
lines p2 p1 p3 p19 p4 p18 p5 p17 p6 p14 p7 p13 p8 p12 p9 p11
mc 16 comb sum=0-7 pol=l
mc 15 comb sum=8-15 pol=l
libtag p16l2 DLIB-h-40-7
end

device p16c1
inherit p16h2
descr PAL16C1: 16 inputs, one 16-term sum on complementary outputs (16 high, 15 low)
partname p16c1 PAL16C1
mc 16 comb sum=0-15 pol=h
mc 15 comb sum=0-15 pol=l
libtag p16c1 DLIB-h-40-7
end
