Assembly x;
Location x;
Device   p10l8;

/* The output is active low and has two product terms.  The complement
   of the equation comes out of the quick minimisation with three
   terms, one of them redundant (!a & c is covered by the other two). */
pin 2  = a;
pin 3  = b;
pin 4  = c;
pin 18 = y;

y = !a & !b # a & !c;
