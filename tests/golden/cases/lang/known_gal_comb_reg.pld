Name G156;
Partno P156;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8ms;
/* @bug B010: GAL registered mode, comb and .D on one pin: reference accepts when OE term equals first D term; freecupl rejects 0013cc */
/* @flags -jaxf */
pin 6 = a0;
pin 8 = a1;
pin 10 = a2;
pin 23 = a3;
pin 1 = clk;
pin 19 = q0;
pin 22 = q1;
field fa = [a3..0];
t0 = !a1;
t1 = a3 $ !((!a2 # !a0 # t0));
t2 = (t1 $ a3);
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
!q0.d = !((a0 & !a1 # (q1 # !t1 # !q1) # (t0 $ t1)));
q1.d = !t2;
pin 20 = tq0;
table fa => tq0 {
  0 => 1;
  3 => 0;
  2 => 1;
  6 => 1;
}
q0 = a0;
