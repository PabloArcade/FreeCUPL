Name inter_po; Partno INTER_PO; Revision 01; Date 01/01/26; Designer test; Company test; Assembly x; Location x;
Device g22v10;
pin 2 = a; pin 3 = b; pin 4 = c; pin 1 = clk;
pin 23 = y0; pin 22 = y1; pin 21 = y2; pin 20 = y3;
x = !(a & b);
w = a & b;
v = !a;
y0.d = x;
y1.d = !w;
y2.d = v;
y3.d = !x;
