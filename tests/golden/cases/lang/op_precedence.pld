Name op_prece; Partno OP_PRECE; Revision 01; Date 01/01/26; Designer test; Company test; Assembly x; Location x;
Device g22v10;
pin 2 = a; pin 3 = b; pin 4 = c; pin 5 = e;
pin 23 = y0; pin 22 = y1; pin 21 = y2; pin 20 = y3;
y0 = a # b & c;
y1 = a $ b # c;
y2 = a & b $ c & e;
y3 = !a & b # !(c $ e);
