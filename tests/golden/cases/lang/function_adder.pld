Name function; Partno FUNCTION; Revision 01; Date 01/01/26; Designer test; Company test; Assembly x; Location x;
Device g16v8;
pin [1..4] = [x1..4];
pin [5..8] = [y1..4];
pin [12..15] = [z1..4];
pin [16..18] = [c1..3];
pin 19 = carry;
function adder_slice(x, y, cin, cout) {
  cout = cin & x # cin & y # x & y;
  adder_slice = cin $ (x $ y);
}
z1 = adder_slice(x1, y1, 'b'0, c1);
z2 = adder_slice(x2, y2, c1, c2);
z3 = adder_slice(x3, y3, c2, c3);
z4 = adder_slice(x4, y4, c3, carry);
