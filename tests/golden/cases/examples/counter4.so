  12: /* reset, count up through the wrap, hold, count down, preset */
  13: 
  14: FIELD count = [q3,q2,q1,q0];
  15:
  16: ORDER: clk, %1, rst, pre, en, dir, %2, count, %2, tc;
  17: 

