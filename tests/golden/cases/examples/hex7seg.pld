Name     hex7seg;
Partno   EX001;
Revision 01;
Date     11/16/26;
Designer DARKSOFT;
Company  FreeCUPL;
Assembly None;
Location None;
Device   g16v8;

/* SPDX-License-Identifier: GPL-3.0-or-later */
/* Hexadecimal to seven-segment decoder (active-high segments) with a
   blanking input.  Shows: pin lists, fields, a TABLE on a field and a
   field equation.
   Segment layout:      a
                      f   b
                        g
                      e   c
                        d                                          */

pin [2..5]   = [d0..3];          /* hex digit, d0 = least significant */
pin 6        = blank;            /* 1 = all segments off */
pin [19..13] = [sa, sb, sc, sd, se, sf, sg];

field digit = [d3..0];
field seg   = [sa, sb, sc, sd, se, sf, sg];
field lit   = [la, lb, lc, ld, le, lf, lg];   /* intermediate pattern */

table digit => lit {
    'h'0 => 'b'1111110;   'h'1 => 'b'0110000;
    'h'2 => 'b'1101101;   'h'3 => 'b'1111001;
    'h'4 => 'b'0110011;   'h'5 => 'b'1011011;
    'h'6 => 'b'1011111;   'h'7 => 'b'1110000;
    'h'8 => 'b'1111111;   'h'9 => 'b'1111011;
    'h'A => 'b'1110111;   'h'B => 'b'0011111;
    'h'C => 'b'1001110;   'h'D => 'b'0111101;
    'h'E => 'b'1001111;   'h'F => 'b'1000111;
}

seg = lit & !blank;
