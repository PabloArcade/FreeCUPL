   9: Device   p16l8;
  10: 
  11: /* SPDX-License-Identifier: GPL-3.0-or-later */
  12: /* The address is given as a hex value for the field maddr (6 bits:
  13:    a15..a10) and ioaddr (2 bits: a7..a6).  The chip selects are listed
  14:    by name, so H means "selected". */
  15: 
  16: FIELD ioaddr = [a7,a6];
  17: FIELD maddr = [a15,a14,a13,a12,a11,a10];
  18:
  19: ORDER: mreq, iorq, %2, maddr, %2, ioaddr, %2,
  20:        rom_cs, ram_cs, vid_cs, uart_cs, pio_cs;
  21: 

