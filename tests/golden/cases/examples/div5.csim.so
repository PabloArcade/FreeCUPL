  12: /* reset, two full periods, hold in the middle of a period, reset */
  13: 
  14: FIELD cnt = [n2,n1,n0];
  15:
  16: ORDER: clk, %1, rst, en, %2, n2, n1, n0, %2, tc, div;
  17: 

======================
      c r         d   
      l se  nnn  ti   
      k tn  210  cv   
======================
reset
0001: 0 10  LLL  LL
count
0002: C 01  LLH  LL
0003: C 01  LHL  LL
0004: C 01  LHH  LH
0005: C 01  HLL  HH
0006: C 01  LLL  LL
0007: C 01  LLH  LL
0008: C 01  LHL  LL
0009: C 01  LHH  LH
0010: C 01  HLL  HH
0011: C 01  LLL  LL
count to 2, hold, count
0012: C 01  LLH  LL
0013: C 01  LHL  LL
0014: C 00  LHL  LL
0015: C 00  LHL  LL
0016: C 01  LHH  LH
reset
0017: 0 11  LLL  LL
