LISTING FOR SIMULATION FILE: shift8.si

   1: Name     shift8;
   2: Partno   EX005;
   3: Revision 01;
   4: Date     11/16/26;
   5: Designer DARKSOFT;
   6: Company  FreeCUPL;
   7: Assembly None;
   8: Location None;
   9: Device   g22v10;
  10: 
  11: /* SPDX-License-Identifier: GPL-3.0-or-later */
  12: /* clear, shift in 1 0 1 1, hold, shift the pattern out, output enable */
  13: 
  14: FIELD data = [q7,q6,q5,q4,q3,q2,q1,q0];
  15:
  16: ORDER: clk, %1, clr, sh, sin, soe, %2, data, %2, nz, sout;
  17: 

=============================
                         s   
      c c ss             o   
      l lsio            nu   
      k rhne    data    zt   
=============================
clear
0001: 0 1001  LLLLLLLL  LL
shift in 1, 0, 1, 1
0002: C 0111  LLLLLLLH  HL
0003: C 0101  LLLLLLHL  HL
0004: C 0111  LLLLLHLH  HL
0005: C 0111  LLLLHLHH  HL
hold
0006: C 0001  LLLLHLHH  HL
0007: C 0011  LLLLHLHH  HL
shift zeros until the first 1 reaches q7
0008: C 0101  LLLHLHHL  HL
0009: C 0101  LLHLHHLL  HL
0010: C 0101  LHLHHLLL  HL
0011: C 0101  HLHHLLLL  HH
serial output disabled, then enabled
0012: 0 0000  HLHHLLLL  HZ
0013: 0 0001  HLHHLLLL  HH
clear
0014: 0 1001  LLLLLLLL  LL
