Name     traffic;
Partno   EX003;
Revision 01;
Date     11/16/26;
Designer DARKSOFT;
Company  FreeCUPL;
Assembly None;
Location None;
Device   g16v8;

/* SPDX-License-Identifier: GPL-3.0-or-later */
/* reset, wait on the main road, one full cycle, reset during the cycle */

ORDER: clk, %1, oe, %1, rst, car, %2, s1, s0, %2,
       main_g, main_y, main_r, %1, side_g, side_y, side_r;

VECTORS:
$MSG "reset";
C 1 10  LL  HLL LLH
$MSG "no car: the main road stays green";
C 1 00  LL  HLL LLH
C 1 00  LL  HLL LLH
$MSG "a car arrives";
C 1 01  LH  LHL LLH
C 1 00  HH  LLH HLL
C 1 00  HL  LLH LHL
C 1 00  LL  HLL LLH
C 1 00  LL  HLL LLH
$MSG "reset while the side road is green";
C 1 01  LH  LHL LLH
C 1 01  HH  LLH HLL
C 1 11  LL  HLL LLH
$MSG "outputs disabled";
0 0 00  ZZ  HLL LLH
