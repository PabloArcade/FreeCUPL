function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0 = (!a1 & !(!(a4)));
!q2 = [a4,a3,a0]:#;
!q3 = a0;
condition {
  if !a4 & !a3 out q1;
  default out q1;
}
