pin 4 = a0;
pin 7 = a1;
pin 9 = a2;
pin 10 = !a3;
pin 14 = a4;
pin 22 = q0;
pin 21 = !q1;
pin 15 = !q2;
pin 16 = !q3;
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
