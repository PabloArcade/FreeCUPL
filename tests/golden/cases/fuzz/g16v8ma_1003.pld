Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8ma;
/* @flags -jaxf */
pin 1 = a0;
pin 4 = a1;
pin 7 = !a2;
pin 9 = a3;
pin 11 = a4;
pin 12 = !q0;
pin 14 = q1;
pin 13 = q2;
pin 17 = !q3;
pin 16 = q4;
pin 15 = !q5;
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0 = a4 & !a1 & a2 # a4 & a2 & a1 # a4 & !a0;
q1 = [a2,a1]:#;
APPEND q2 = !q5 & q4;
APPEND q2 = !a2;
q2.oe = !a1;
q3 = (!(a1) # a3 # (a1 $ a2) & (a0 $ !a4) & (!a3 # a0 # !a0) & (!a0 # !a1 # a4) & (a1 $ a3) # 'b'1 # !a4);
q4 = OFF & a3 # OFF;
!q5 = a2;
