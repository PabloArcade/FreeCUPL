Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p10l8;
/* @flags -jaxm4 */
pin 4 = a0;
pin 5 = a1;
pin 9 = !a2;
pin 16 = !q0;
pin 13 = q1;
pin 17 = !q2;
!q0 = [a2,a0,a1]:&;
q1 = !a0 & a2 & !a1 # a0;
q2 = (!a0 # a1 # (!a0 # !a1)) & a0 # a0 # a2 & a0 & a1 & a1;
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
