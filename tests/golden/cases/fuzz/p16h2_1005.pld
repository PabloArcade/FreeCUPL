Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16h2;
pin [1,6,8,9,14,17] = [!a0, a1, a2, !a3, a4, a5];
pin [15,16] = [q0,q1];
field fa = [a5..0];
t0 = (!(!(a0)) # !a3 & a1 & a1 & (a3 $ !a1) & (a3 $ !a4) # (a4 $ a2));
t1 = !a0;
t2 = a1 # a3 # t1 # !a0 # !(a5);
q0 = [a3,a4]:&;
q1 = !((t0 $ a1));
min q0 = 1;
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
