Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cpas;
/* @flags -jaxm0 */
pin [1,2,3,5,6,8] = [!a0, !a1, a2, !a3, a4, a5];
pin 1 = clk;
pin [17,13,12,15,19] = [!q0,q1,q2,q3,q4];
field fa = [a0..a2];
APPEND q0 = !a4 & a5;
APPEND q0 = !a1;
APPEND q1 = !a4 & a2;
APPEND q1 = !a4;
q3 = !a1 & a2 & !a4 # a4 # a0 & a5 & a4 # a4;
APPEND q4 = a0 & a5;
condition {
  if a4 & a0 out q2;
}
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%6};
$REPEND
