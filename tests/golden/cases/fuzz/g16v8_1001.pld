Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8;
/* @flags -jaxf */
pin 1 = !a0;
pin 3 = a1;
pin 4 = a2;
pin 5 = a3;
pin 6 = a4;
pin 7 = !a5;
pin 19 = q0;
pin 12 = q1;
pin 18 = q2;
pin 17 = !q3;
pin 16 = q4;
field fa = [a3..1];
q0 = ('b'1 # (a1 # a4 & a0 # a5) # !a4);
q1 = (a2 $ a3) # !(!a2) # 'h'1;
APPEND q2 = !a0 & !a1;
APPEND q2 = a1;
q3 = (!a0 & !a0);
condition {
  if a3 out q4;
}
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
