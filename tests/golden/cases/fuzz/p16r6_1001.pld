Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16r6;
/* @flags -jaxm4 */
pin 3 = a0;
pin 4 = a1;
pin 5 = a2;
pin 6 = !a3;
pin 7 = a4;
pin 8 = !a5;
pin 9 = !a6;
pin 15 = q0;
pin 16 = q1;
field fa = [a5..2];
t0 = a0;
t1 = a4 & a6 & (a6 # a2);
t2 = ((a4 $ a0) # (a2 & a4 & a1 & !(!a1)) # !a6);
q1.d = a4;
condition {
  if a3 out q0;
  default out q0;
}
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
