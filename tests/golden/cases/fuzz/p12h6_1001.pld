Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p12h6;
pin 2 = !a0;
pin 4 = a1;
pin 5 = a2;
pin 6 = a3;
pin 9 = a4;
pin 11 = !a5;
pin 16 = q0;
pin 17 = !q1;
pin 15 = q2;
t0 = !(a2) # !(a1) # (!(!a2) # a0 # !a1 # a5 # !a0) # a2;
q0 = !(!a1) & (a4 $ t0);
!q1 = a2;
condition {
  if a2 & a0 out q2;
}
