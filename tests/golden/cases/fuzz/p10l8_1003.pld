Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p10l8;
pin 1 = a0;
pin 2 = !a1;
pin 3 = a2;
pin 4 = a3;
pin 7 = a4;
pin 9 = a5;
pin 11 = a6;
pin [17,15] = [q0,q1];
field fa = [a6..0];
q0 = a2 # !a2 & !a3;
q1 = fa:'b'X11X1X0;
pin 16 = tq0;
table fa => tq0 {
  2F => 0;
  7A => 0;
  7 => 0;
  7E => 1;
}
min q1 = 4;
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
