Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8c;
pin [2,3,4,5,7,8,9] = [!a0, a1, !a2, !a3, a4, a5, !a6];
pin [12,18,15,14,17,19] = [q0,q1,!q2,!q3,q4,q5];
field fa = [a3..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0.d = fa:'d'6;
q1.d = (a1 # !a3) & a1 # a0 # !a6 & (a2 $ a1);
q2 = !a0;
q3.d = 'b'1 $ 'h'1 $ 'b'0;
q4 = q2 & !a5 & q0;
q5.d = a2 & a5 # q3 & !a5 & a4 # !q1 # q4 & !a5 & !a6;
