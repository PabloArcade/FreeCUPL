Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16l8;
pin [1,2,3,5,11] = [!a0, a1, a2, a3, a4];
pin [14,16,12,18,13] = [q0,!q1,q2,!q3,q4];
field fa = [a1..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
APPEND q0 = !a1 & a2;
q0.oe = a2 & a1;
!q1 = !a3;
APPEND q2 = a0;
q2.oe = !a0 & a1;
q3.oe = a4 & a3;
q4 = OFF & a1 # OFF;
q4.oe = a4 & a2;
condition {
  if a1 out q3;
}
