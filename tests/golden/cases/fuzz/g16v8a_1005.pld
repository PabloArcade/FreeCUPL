Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8a;
/* @flags -jaxm2 */
pin [1,3,4,6,7,8,9] = [!a0, a1, a2, a3, a4, !a5, a6];
pin 1 = clk;
pin 17 = q0;
pin 14 = q1;
pin 15 = !q2;
pin 18 = !q3;
pin 13 = !q4;
pin 19 = q5;
q0 = (a6 $ a4);
q0.oe = a2;
q1 = a3 & q2 # a1 & q2 # !a1;
q1.oe = a6 & a0;
q2 = ((!a5 & (!a4 # a1 # !a2)) $ a1 & a4 & a2 & (!a0 # !a0 # a1) $ (!a6 # !a5 # a4) # !a0 & !a2 # (!a6 # a0));
q3 = (a4 $ a3);
q3.oe = !a1 & a3;
APPEND q4 = a4;
APPEND q4 = !a5;
!q5 = [a3,a2,a6,a0]:&;
q5.oe = a3;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%7};
$REPEND
