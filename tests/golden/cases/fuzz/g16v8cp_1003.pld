Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cp;
/* @flags -jaxf */
pin [3,5,6,7,9] = [a0, a1, !a2, !a3, a4];
pin 11 = !oe;
pin 14 = !s0;
pin 13 = !q1;
pin 17 = q2;
pin 15 = !q3;
pin 16 = !q4;
pin 18 = q5;
field fa = [a0..a4];
t0 = a1;
!q1.d = !t0 # !a4 & !a1 & t0 # a1 & t0 & a0 # a2 & !a1 & a4;
q2 = (a0 $ t0);
q2.oe = 'b'1;
q3.d = q4 # q4 & !q1 & a3;
APPEND q4.d = q3 & a4;
q5.d = q1;
field st = [s0];
sequence st {
  present 1 next 1;
}
pin 12 = tq0;
table fa => tq0 {
  11 => 1;
  1F => 1;
  6 => 0;
  4 => 1;
}
