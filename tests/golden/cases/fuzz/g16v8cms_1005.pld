Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cms;
pin 6 = in_x;
pin 7 = in_y;
pin 9 = !in_z;
pin 1 = clk;
pin 19 = !out_a;
pin 16 = out_b;
pin 14 = out_c;
pin 18 = out_d;
t0 = !in_z;
t1 = !t0;
t2 = !(!in_z);
out_a = [in_z,in_y,in_x]:#;
out_b.d = [in_x,in_y,in_z]:#;
APPEND out_c = !t2;
out_c.oe = !in_z & in_y;
out_d.d = (in_y # in_x # (in_z $ in_y)) & !t2 & (!t1 & t1 & in_x # (t0 $ t2) # 'b'0);
