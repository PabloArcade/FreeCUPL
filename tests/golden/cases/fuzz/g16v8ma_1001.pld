Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8ma;
pin 1 = !a0;
pin 2 = a1;
pin 3 = a2;
pin 4 = a3;
pin 7 = a4;
pin 9 = a5;
pin [13,18,19,16] = [q0,!q1,!q2,q3];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0 = !a1 & a2 # a4 & !a1 & !a0;
q1 = [a1,a0,a4,a3]:#;
q1.oe = a1;
q2 = 'h'1;
!q3 = (a1 $ a3);
