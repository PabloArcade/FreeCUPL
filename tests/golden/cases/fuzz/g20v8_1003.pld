Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8;
/* @flags -jaxm0 */
pin 5 = a0;
pin 6 = a1;
pin 7 = !a2;
pin 8 = a3;
pin 9 = !a4;
pin 13 = !a5;
pin 14 = a6;
pin 1 = clk;
pin [18,17,20,21] = [q0,q1,!q2,q3];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
t0 = !(!a2 & (a0 $ a6));
t1 = a2;
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
APPEND q0 = a5 & !a2;
q1 = [a1,a0]:&;
q2.oe = a2 & a1;
q3 = ON & a5 # ON;
q3.oe = 'b'1;
condition {
  if !a6 out q2;
  default out q2;
}
