Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p22v10;
/* @flags -jaxm4 */
pin [4,5,6,7,11] = [a0, !a1, a2, !a3, !a4];
pin 1 = clk;
pin 19 = !s0;
pin 21 = !s1;
t0 = (a4 $ !a3);
t1 = !((a4 & !a1) # (a4 & !a1));
t2 = ((t0 $ a4) # a1 # t0 # a1 # t1 # a1 # !a2 # (!a0 # !t1 # a2));
field st = [s0,s1];
sequenced st {
  present 0 if !a1 & a3 next 2; default next 3;
  present 3 if !a2 next 2; if !a0 & !a3 next 2;
  present 2 if !a3 & a0 next 2; if a1 next 3;
}
s0.ar = a2 & !a1;
min s1.d = 2;
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
