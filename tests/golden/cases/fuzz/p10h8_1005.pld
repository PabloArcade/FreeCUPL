Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p10h8;
/* @flags -jaxm2 */
pin [1,2,4,5,6,7,11] = [in_x, !in_y, in_z, in_w, in_v, !in_u, !in_t];
pin 14 = out_a;
pin 15 = out_b;
pin 19 = out_c;
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
out_a = in_u & in_v & !in_z;
!out_b = !in_x & in_v & in_u;
out_c = in_x;
