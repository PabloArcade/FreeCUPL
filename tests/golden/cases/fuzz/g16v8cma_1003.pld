Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cma;
pin 1 = !in_x;
pin 3 = in_y;
pin 11 = in_z;
pin 19 = out_a;
pin 18 = !out_b;
pin 15 = out_c;
pin 12 = !out_d;
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
out_a = in_x & in_y;
out_a.oe = in_z;
out_b = (((in_z $ in_x) & (in_x # !in_z)) $ ('B'0 & in_z) $ !in_y & (in_x # in_z # !in_z));
out_c = [in_y,in_x,in_z]:&;
out_c.oe = !in_x;
APPEND out_d = in_x;
APPEND out_d = in_z;
