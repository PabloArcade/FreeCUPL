Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8as;
pin 2 = a0;
pin 5 = a1;
pin 6 = a2;
pin 7 = a3;
pin 9 = !a4;
pin 1 = clk;
pin [12,14,15,19,16] = [q0,!q1,q2,q3,!q4];
q0 = a2;
q1 = [a0,a4,a3,a2]:&;
!q2 = [a4,a2,a0]:$;
q3 = !(a0);
q4 = a0;
$MACRO AND2 x y z
x = y & z;
$MEND
