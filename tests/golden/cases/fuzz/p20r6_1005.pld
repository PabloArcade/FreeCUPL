Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20r6;
pin 3 = !a0;
pin 7 = a1;
pin 8 = a2;
pin 11 = a3;
pin [18,21,17,16,19] = [q0,q1,q2,!q3,q4];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
q0.d = ((a3 $ a1) # (a1 # !a1)) & (a3 & !a0) # a2 # !a2;
APPEND q1.d = q4;
APPEND q1.d = !a3;
q2.d = [a2,a1]:#;
q3.d = (a0 $ q1);
q4.d = (a0 $ a1);
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%4};
$REPEND
