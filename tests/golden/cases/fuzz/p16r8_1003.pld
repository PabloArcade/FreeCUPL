Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16r8;
/* @flags -jaxm0 */
pin [2,3,7,8] = [a0, a1, a2, !a3];
pin 1 = clk;
pin 12 = !s0;
pin 15 = s1;
pin 16 = s2;
pin 13 = !q3;
field fa = [a1..a3];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
q3.d = a1 & !a2 & !a0 # a1 # a3 & !a2 # !a3 & a1;
field st = [s0,s1,s2];
sequence st {
  present 7 next 6;
}
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
