Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cms;
pin [2,3,4,5,6,7,9] = [!a0, a1, a2, a3, a4, a5, a6];
pin 11 = !oe;
pin [16,14,13,18,12,15] = [q0,!q1,!q2,q3,q4,q5];
field fa = [a0..a2];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
q0.d = (a3 & ((a0 & !a4) # a6 # (a0 # a1 # !a1)) & (a2 & (a0 # !a2 # !a3)));
APPEND q2.d = !a0;
q3.d = ON & a4 # OFF;
q4.d = [a4,a5,a2]:&;
!q5.d = a1 & q2;
condition {
  if a6 & a2 out q1;
}
