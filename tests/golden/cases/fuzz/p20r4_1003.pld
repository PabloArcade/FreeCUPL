Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20r4;
pin 8 = a0;
pin 11 = a1;
pin 14 = a2;
pin [15,22,18,20,16] = [q0,q1,q2,q3,q4];
field fa = [a0..a2];
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
APPEND q0 = a1;
q0.oe = a1 & !a2;
q1 = fsel(a0, a2, q3);
q1.oe = a0;
q2.d = a1 # !a2 & !a0 # a0 & a1 & !a2 # a1;
!q3.d = (q4 $ a0) # a1;
q4 = fsel(a2, a0, a1);
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%3};
$REPEND
