Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8ma;
/* @flags -jaxf */
pin [8,10,13,14] = [a0, a1, a2, !a3];
pin 1 = clk;
pin [16,17,18] = [q0,q1,!q2];
field fa = [a0..a2];
q0 = q2 & q1;
q1 = a2 # a2 # a1 & !q0;
q2 = fa:[7..7];
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%4};
$REPEND
