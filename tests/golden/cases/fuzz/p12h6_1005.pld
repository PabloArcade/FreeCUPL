Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p12h6;
/* @flags -jaxm2 */
pin 2 = in_x;
pin 5 = in_y;
pin 6 = !in_z;
pin 7 = !in_w;
pin 12 = !in_v;
pin 15 = out_a;
pin 16 = out_b;
pin 14 = out_c;
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
out_a = in_v & in_z & in_w;
out_b = ((in_z $ !in_y) $ (in_w $ in_x));
out_c = in_v;
out_a.t = in_x;
