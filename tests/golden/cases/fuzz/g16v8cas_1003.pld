Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cas;
pin 1 = !a0;
pin 2 = a1;
pin 4 = !a2;
pin 5 = a3;
pin 8 = !a4;
pin 9 = a5;
pin 1 = clk;
pin 18 = q0;
pin 17 = !q1;
pin 16 = q2;
field fa = [a0..a5];
t0 = a3;
t1 = !a3 & (a1 $ !a3) & (t0 # a5) # t0;
t2 = t0 # (a4 $ a5);
q0 = [a3,a5,a0]:$;
q2 = ((a5 & t1) # !(!a1) & !(!t2 & a4 & !a2));
condition {
  if !a1 & a5 out q1;
  default out q1;
}
pin 14 = tq0;
table fa => tq0 {
  E => 1;
  34 => 0;
  0 => 0;
  28 => 1;
}
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
bad_int = a0 & undefined_var;
q0.oe = bad_int;
