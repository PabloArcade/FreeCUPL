pin 1 = a0;
pin 3 = a1;
pin 4 = a2;
pin 8 = a3;
pin 9 = a4;
pin 11 = a5;
pin 14 = a6;
pin 1 = clk;
pin 19 = q0;
pin 16 = !q1;
pin 20 = q2;
