Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8ms;
pin [3,4,6,7] = [a0, a1, a2, a3];
pin 11 = !oe;
pin 18 = !q0;
field fa = [a0..a2];
APPEND q0.d = a3;
APPEND q0.d = !a3 & a1;
min q0.d = 0;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%4};
$REPEND
