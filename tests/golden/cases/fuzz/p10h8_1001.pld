Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p10h8;
/* @flags -jaxm2 */
pin 2 = !a0;
pin 5 = a1;
pin 6 = !a2;
pin 9 = a3;
pin 18 = q0;
pin 16 = !q1;
pin 14 = q2;
t0 = !(a2) # !(a1) # (!(!a2) # (a0 # !a1 # a3) # (!a0 & a3 & !a1)) # ((a2 # a0) # !a3 # a3 # !a2 # a3);
q0 = a0 & a1 # t0 & !a3;
q1 = (a0 $ t0);
q2 = ((a1 $ t0) # (a1 # a3 # (!a0 & a2)));
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
q0.t = a0;
