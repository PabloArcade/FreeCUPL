Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20r8;
/* @flags -jaxf */
pin 4 = !a0;
pin 6 = a1;
pin 7 = a2;
pin 11 = a3;
pin 14 = a4;
pin 23 = !a5;
pin [22,15,21,20,19] = [q0,q1,q2,!q3,q4];
q0.d = ('b'1 # (a3 # a2 # q3) # (!q4 & !q3) $ q1 $ a5);
q1.d = !a2 # a2 & a5 # a1 & !a3 # !a2;
q2.d = a4 & !a2 # a5;
q3.d = [a0,a1]:#;
q4.d = !(!((a1 $ a5)));
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%6};
$REPEND
