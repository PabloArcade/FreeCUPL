Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16r6;
/* @flags -jaxm2 */
pin 3 = !a0;
pin 5 = a1;
pin 7 = a2;
pin 1 = clk;
pin 18 = !q0;
pin 15 = q1;
pin 14 = q2;
pin 19 = q3;
pin 16 = q4;
pin 13 = q5;
field fa = [a0..a1];
t0 = a0;
t1 = ((a1 # a0) & t0 & (a0 # t0 # !a1)) $ a2;
q0.d = !t1 & a1 # !t0 # a0 & q5;
q1.d = q5 & !a1 & !t1 # q2;
APPEND q2.d = a2 & a0;
q3 = (t1 $ a1);
q3.oe = !a2 & a0;
q4.d = !t0 & !a1 & a2 # t1 & a1 & a0 # t1 & !a1 & !t0;
!q5.d = [a1,a2,a0]:&;
