Name G1001;
Partno P1001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cpma;
/* @flags -jaxm0 */
pin 6 = a0;
pin 8 = a1;
pin 9 = a2;
pin 11 = a3;
pin 1 = clk;
pin [19,18,15,13] = [!q0,q1,q2,!q3];
field fa = [a1..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
q0 = [a0,a2,a3,a1]:#;
q0.oe = 'b'1;
q1 = a1 & a2 & !q2;
q1.oe = a0 & a3;
q2 = ON & a2 # ON;
q3 = a3 & !a1 # q2 & a3 & !a1 # a0;
q3.oe = 'b'1;
