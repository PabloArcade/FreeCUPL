Name G1005;
Partno P1005;
Revision 01;
Date 01/01/26;
Company gen;
Assembly x;
Location x;
Device p16r6;
/* @flags -jaxm2 */
pin [2,3,5,8,9] = [!a0, a1, !a2, !a3, a4];
pin 1 = clk;
pin 18 = q0;
pin 15 = q1;
pin 12 = q2;
pin 17 = !q3;
pin 19 = q4;
t0 = (a4 # a4 # !a1);
q0.d = !a1 & a3 & !a4 # a2 # a1 # !a1 & a4;
q2 = a0 & !q3 & !q0;
q2.oe = a2;
q3.d = ('B'0 $ (a4 $ a2));
q4 = (t0 # !a4);
q4.oe = a0 & a2;
condition {
  if a4 & !a2 out q1;
}
