Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8cpas;
/* @flags -jaxm2 */
pin [1,3,11] = [!a0, a1, !a2];
pin 12 = q0;
field fa = [a0..a1];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = a0;
t1 = !(!a1 & (!a2 # a0));
q0 = ('b'0 # ((!a2 & !t1) & a2) # t0);
pin 19 = tq0;
table fa => tq0 {
  1 => 1;
  0 => 0;
  3 => 1;
  2 => 0;
}
