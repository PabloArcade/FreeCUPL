Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g22v10;
/* @flags -jaxm3 */
pin [2,4,10] = [!a0, !a1, a2];
pin 16 = s0;
pin 21 = q1;
pin 15 = q2;
pin 17 = q3;
pin 18 = !q4;
field fa = [a0..a2];
!q1.d = a1 & !a0 # a1;
q1.oe = !a2;
APPEND q2.d = !s0 & !q1;
q2.oe = a2 & !a0;
APPEND q3.d = q1 & !a2;
APPEND q3.d = q1 & q4;
q4.d = a2 & !a1 & !a0 # !a2;
field st = [s0];
sequenced st {
  present 0 next 1;
}
