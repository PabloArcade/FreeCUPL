Name G1003;
Partno P1003;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8cps;

pin 1 = a0;
pin 6 = a1;
pin 8 = a2;
pin 10 = a3;
pin 11 = a4;
pin 1 = clk;
pin [20,15,16,19] = [q0,q1,q2,!q3];
field fa = [a4..2];
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
APPEND q0 = a2;
APPEND q0 = a0 & a2;
!q1 = !a1 $ (a2 $ a4);
q2 = !a2 & a3 # a2 & a0;
q3 = a1 & a4 & a0 # !a4 & !a0 & a2;
