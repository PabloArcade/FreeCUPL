Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16rp6v;
pin 5 = OUT;
pin 4 = !i1;
pin 3 = !i2;
pin 9 = !i3;
pin 13 = o0;
pin 18 = include;
pin 16 = o2;
pin 15 = o3;
pin 12 = o4;

o0.d = (i1 $ i3);
include.d = 'b'0;
o2.d = i3;
o3.d = ((i3 & !o2 & !o0) # i2 # !OUT);
o4 = (i3 # (o0 & i1 & !include) # (!i2 & o3 & !o0));

