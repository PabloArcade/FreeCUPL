Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16rp6;
pin 5 = i0;
pin 4 = !rev;
pin 3 = !i2;
pin 9 = !REPEND;
pin 13 = o0;
pin 18 = o1;
pin 16 = o2;
pin 15 = o3;
pin 12 = o4;

o0.d = (rev $ REPEND);
o1.d = 'b'0;
o2.d = REPEND;
o3.d = ((REPEND & !o2 & !o0) # i2 # !i0);
o4 = (REPEND # (o0 & rev & !o1) # (!i2 & o3 & !o0));

