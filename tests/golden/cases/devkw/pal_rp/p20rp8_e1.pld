Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20rp8;
pin 9 = !i0;
pin 14 = MACRO;
pin 16 = o0;
pin 21 = o1;
pin 19 = pinnnode;
pin 18 = o3;
pin 15 = o4;

o0.d = (i0 $ MACRO);
o1.d = 'b'0;
pinnnode.d = o1;
o3.d = ((o1 & pinnnode & !o0) # o0 # !i0);
o4.d = (MACRO # (!o0 & MACRO & pinnnode) # (!MACRO & o0 & o3));

