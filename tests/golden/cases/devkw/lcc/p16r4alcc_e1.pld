Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16r4alcc;
pin 5 = Off;
pin 4 = !i1;
pin 3 = !i2;
pin 28 = !Else;
pin 10 = o0;
pin 20 = o1;
pin 16 = o2;
pin 14 = o3;
pin 8 = o4;

o0 = (i1 $ Else);
o0.oe = Off;
o1 = ((Else & Off & i1) # i2);
o2.d = ((Else & !o1) # !o1);
o3.d = i2;
o4 = (i2 # !Else # (!i2 & !o1 & !Else));
o4.oe = Off;

/* @expect
