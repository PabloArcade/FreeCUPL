Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16r8alcc;
pin 5 = i0;
pin 4 = !i1;
pin 3 = !i2;
pin 28 = !i3;
pin 10 = o0;
pin 20 = o1;
pin 16 = o2;
pin 14 = o3;
pin 8 = on;

o0.d = (i1 $ i3);
o1.d = 'b'0;
o2.d = i3;
o3.d = ((i3 & !o2 & !o0) # i2 # !i0);
on.d = (i3 # (o0 & i1 & !o1) # (!i2 & o3 & !o0));

