pin 8 = !date;
pin 5 = i1;
pin 13 = !o0;
pin 18 = !o1;
pin 16 = !o2;
pin 15 = o3;
pin 12 = !o4;

o0 = (!i1 # date # (date & i1));
o0.oe = (!i1 & !date);
o1.d = (i1 & !date);
o2 = (!date # (o1 & !date & i1) # (i1 & !o1 & !date));
o2.oe = date;
o3 = ((i1 & o1) # (i1 & o1));
o3.oe = (!date & !i1);
o4 = ((!date & !o1 & !i1) # o1 # (i1 & o1));

