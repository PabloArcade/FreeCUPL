Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20g10lcc;
pin 10 = !jump;
pin 6 = REVISION;
pin 21 = !o0;
pin 19 = o1;
pin 24 = o2;

o0.d = ((!REVISION & jump) # REVISION # (!jump & !REVISION));
o0.oe = (!jump & REVISION);
o1.d = (!jump & REVISION);
o2 = !REVISION;

