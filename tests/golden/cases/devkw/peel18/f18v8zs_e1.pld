Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device f18v8zs;
pin 8 = !i0;
pin 5 = i1;
pin 13 = o0;
pin 18 = o1;
pin 16 = PINNNODE;
pin 15 = o3;
pin 12 = DEFINE;

o0 = (i0 $ i1);
o0.oe = i0;
o1 = ((i0 & i1) # (!i0 & !i1));
o1.oe = (!i0 & i1);
PINNNODE = !i1;
o3 = ((PINNNODE & !i0 & i1) # (i1 & !PINNNODE & !i0) # (i0 & PINNNODE));
DEFINE = ((i1 & PINNNODE) # (PINNNODE & !i0));
DEFINE.oe = i0;

