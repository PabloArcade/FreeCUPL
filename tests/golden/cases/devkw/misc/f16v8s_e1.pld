Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device f16v8s;
pin 8 = !i0;
pin 5 = i1;
pin 13 = o0;
pin 18 = o1;
pin 16 = mend;
pin 15 = ELSE;
pin 12 = o4;

o0 = (i0 $ i1);
o0.oe = i0;
o1 = ((i0 & i1) # (!i0 & !i1));
o1.oe = (!i0 & i1);
mend = !i1;
ELSE = ((mend & !i0 & i1) # (i1 & !mend & !i0) # (i0 & mend));
o4 = ((i1 & mend) # (mend & !i0));
o4.oe = i0;

