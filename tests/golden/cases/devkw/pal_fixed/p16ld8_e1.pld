Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16ld8;
pin 8 = !i0;
pin 5 = i1;
pin 13 = pinnode;
pin 18 = o1;
pin 16 = o2;
pin 15 = o3;
pin 12 = o4;

pinnode = (i0 $ i1);
o1 = 'b'0;
o2 = o1;
o3 = ((o1 & o2 & !pinnode) # pinnode # !i0);
o4 = (i1 # (!pinnode & i1 & o2) # (!i1 & pinnode & o3));

/* @expect
pinnode = (i0 ^ i1)
o1 = 0
o2 = o1
o3 = ((o1 and o2 and (not pinnode)) or pinnode or (not i0))
o4 = (i1 or ((not pinnode) and i1 and o2) or ((not i1) and pinnode and o3))
*/
