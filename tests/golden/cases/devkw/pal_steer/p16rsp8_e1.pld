Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p16rsp8;
pin 5 = i0;
pin 4 = !i1;
pin 3 = !mend;
pin 9 = !i3;
pin 13 = o0;
pin 18 = o1;
pin 16 = o2;
pin 15 = o3;
pin 12 = o4;

o0.d = (i1 $ i3);
o1.d = 'b'0;
o2.d = i3;
o3.d = ((i3 & !o2 & !o0) # mend # !i0);
o4.d = (i3 # (o0 & i1 & !o1) # (!mend & o3 & !o0));

