Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p1020p8lcc;
pin 17 = !i0;
pin 26 = i1;
pin 6 = o0;
pin 24 = Out;
pin 20 = o2;
pin 10 = o3;
pin 5 = NEXT;

o0 = (i0 $ i1);
Out = 'b'0;
o2 = Out;
o3 = ((Out & o2 & !o0) # o0 # !i0);
NEXT = (i1 # (!o0 & i1 & o2) # (!i1 & o0 & o3));

