Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20rsp8;
pin 9 = !i0;
pin 14 = i1;
pin 16 = o0;
pin 21 = o1;
pin 19 = o2;
pin 18 = o3;
pin 15 = FLD;

o0.d = (i0 $ i1);
o1.d = 'b'0;
o2.d = o1;
o3.d = ((o1 & o2 & !o0) # o0 # !i0);
FLD.d = (i1 # (!o0 & i1 & o2) # (!i1 & o0 & o3));

