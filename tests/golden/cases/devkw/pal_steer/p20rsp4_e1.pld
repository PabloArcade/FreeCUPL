Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20rsp4;
pin 9 = !i0;
pin 14 = i1;
pin 16 = o0;
pin 21 = Rev;
pin 19 = MEND;
pin 18 = o3;
pin 15 = o4;

o0 = (i0 $ i1);
o0.oe = i0;
Rev = ((i0 & i1) # (!i0 & !i1));
Rev.oe = (!i0 & i1);
MEND.d = !i1;
o3.d = (!MEND & !i0);
o4 = ((o3 & !i1) # !MEND # i0);

