pin 8 = !Undef;
pin 5 = i1;
pin 13 = o0;
pin 18 = o1;
pin 16 = vectors;
pin 15 = o3;
pin 12 = o4;

o0 = (Undef $ i1);
o0.oe = Undef;
o1 = ((Undef & i1) # (!Undef & !i1));
