Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g20v8cpms;

pin 10 = !i0;
pin 7 = i1;
pin 16 = ON;
pin 21 = !o1;
pin 19 = o2;
pin 18 = o3;
pin 15 = o4;

ON.d = (!i1 & i0);
o1.d = (ON # (!i1 & !ON & !i0));
o2.d = (o1 $ ON);
o3.d = (ON & i1 & !o2);
o4 = ((!i1 & o3 & !o1) # (!ON & !o1));
o4.oe = i0;

