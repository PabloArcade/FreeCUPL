Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20r8;
pin 9 = !i0;
pin 14 = i1;
pin 16 = o0;
pin 21 = MACRO;
pin 19 = o2;
pin 18 = o3;
pin 15 = o4;

o0.d = (i0 $ i1);
MACRO.d = 'b'0;
o2.d = MACRO;
o3.d = ((MACRO & o2 & !o0) # o0 # !i0);
o4.d = (i1 # (!o0 & i1 & o2) # (!i1 & o0 & o3));

