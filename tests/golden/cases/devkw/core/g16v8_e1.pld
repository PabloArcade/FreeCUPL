Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16v8;
pin 8 = !i0;
pin 5 = i1;
pin 13 = o0;
pin 18 = MACRO;
pin 16 = o2;
pin 15 = o3;
pin 12 = o4;

o0 = (i0 $ i1);
o0.oe = i0;
MACRO = ((i0 & i1) # (!i0 & !i1));
MACRO.oe = (!i0 & i1);
o2 = !i1;
o3 = ((o2 & !i0 & i1) # (i1 & !o2 & !i0) # (i0 & o2));
o4 = ((i1 & o2) # (o2 & !i0));
o4.oe = i0;

