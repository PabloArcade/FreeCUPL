Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p20r4;
pin 9 = !on;
pin 14 = i1;
pin 16 = o0;
pin 21 = o1;
pin 19 = o2;
pin 18 = o3;
pin 15 = o4;

o0 = (on $ i1);
o0.oe = on;
o1 = ((on & i1) # (!on & !i1));
o1.oe = (!on & i1);
o2.d = !i1;
o3.d = (!o2 & !on);
o4 = ((o3 & !i1) # !o2 # on);

