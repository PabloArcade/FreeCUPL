Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16v8a;
pin 8 = !i0;
pin 5 = i1;
pin 13 = o0;
pin 18 = Base;
pin 16 = order;
pin 15 = o3;
pin 12 = o4;

o0 = (i0 $ i1);
o0.oe = i0;
Base = ((i0 & i1) # (!i0 & !i1));
Base.oe = (!i0 & i1);
order = !i1;
o3 = ((order & !i0 & i1) # (i1 & !order & !i0) # (i0 & order));
o4 = ((i1 & order) # (order & !i0));
o4.oe = i0;

