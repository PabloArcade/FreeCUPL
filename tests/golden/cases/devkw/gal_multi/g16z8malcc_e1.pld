Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16z8malcc;
pin 11 = !i0;
pin 7 = jump;
pin 19 = Repeat;
pin 25 = o1;
pin 23 = o2;
pin 21 = o3;
pin 18 = o4;

Repeat = (i0 $ jump);
Repeat.oe = i0;
o1 = ((i0 & jump) # (!i0 & !jump));
o1.oe = (!i0 & jump);
o2 = !jump;
o3 = ((o2 & !i0 & jump) # (jump & !o2 & !i0) # (i0 & o2));
o4 = ((jump & o2) # (o2 & !i0));
o4.oe = i0;

