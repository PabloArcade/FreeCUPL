Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p19r6rlcc;
pin 11 = !i0;
pin 7 = i1;
pin 19 = o0;
pin 25 = o1;
pin 23 = o2;
pin 21 = order;
pin 18 = o4;

o0.d = (i0 $ i1);
o1.d = 'b'0;
o2.d = o1;
order.d = ((o1 & o2 & !o0) # o0 # !i0);
o4 = (i1 # (!o0 & i1 & o2) # (!i1 & o0 & order));

