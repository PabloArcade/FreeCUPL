pin 11 = !i0;
pin 7 = JUMP;
pin 19 = o0;
pin 25 = o1;
pin 23 = o2;
pin 21 = o3;
pin 18 = o4;

o0 = (i0 $ JUMP);
o0.oe = i0;
o1 = ((i0 & JUMP) # (!i0 & !JUMP));
o1.oe = (!i0 & JUMP);
o2.d = !JUMP;
o3.d = (!o2 & !i0);
o4 = ((o3 & !JUMP) # !o2 # i0);

