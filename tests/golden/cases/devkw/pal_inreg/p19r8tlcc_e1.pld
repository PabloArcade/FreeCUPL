Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p19r8tlcc;
pin 11 = !i0;
pin 7 = i1;
pin 19 = ON;
pin 25 = o1;
pin 23 = o2;
pin 21 = o3;
pin 18 = o4;

ON.d = (i0 $ i1);
o1.d = 'b'0;
o2.d = o1;
o3.d = ((o1 & o2 & !ON) # ON # !i0);
o4.d = (i1 # (!ON & i1 & o2) # (!i1 & ON & o3));

