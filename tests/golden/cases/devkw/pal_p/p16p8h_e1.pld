o1.oe = ((not i0) and Include)
Order = (not Include)
o3 = ((Order and (not i0) and Include) or (Include and (not Order) and (not i0)) or (i0 and Order))
o4 = ((Include and Order) or (Order and (not i0)))
o4.oe = i0
*/
