Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device p64r32;
pin 7 = SEQUENCE;
pin 42 = !i1;
pin 43 = i2;
pin 38 = i3;
pin 70 = o0;
pin 67 = Fuse;

o0 = ((i1 & SEQUENCE & i3) # (!i1 & i3 & SEQUENCE) # (!i2 & !i3 & !i1));
Fuse.d = 'b'0;

