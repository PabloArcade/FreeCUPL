Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16vp8ma;
pin 9 = !i0;
pin 6 = i1;
pin 12 = MEND;
pin 18 = o1;
pin 16 = o2;
pin 14 = JUMP;
pin 11 = o4;

MEND = (i0 $ i1);
MEND.oe = i0;
o1 = ((i0 & i1) # (!i0 & !i1));
o1.oe = (!i0 & i1);
o2 = !i1;
JUMP = ((o2 & !i0 & i1) # (i1 & !o2 & !i0) # (i0 & o2));
o4 = ((i1 & o2) # (o2 & !i0));
o4.oe = i0;

