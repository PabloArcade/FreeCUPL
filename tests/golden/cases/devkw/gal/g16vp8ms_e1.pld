Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16vp8ms;
pin 6 = i0;
pin 4 = !jump;
pin 3 = !REVISION;
pin 20 = !i3;
pin 12 = o0;
pin 18 = !o1;
pin 16 = !o2;
pin 14 = !o3;
pin 11 = !o4;

o0.d = (!REVISION & jump);
o1.d = (o0 # (!o0 & !i3));
o2.d = (i3 & !o1);
o3 = (!jump # (!o1 & !o2 & jump) # (!o2 & o0));
o4.d = (i0 & REVISION & !jump);

