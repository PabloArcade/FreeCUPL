Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16v8hma;
pin 8 = !i0;
pin 5 = i1;
pin 14 = o0;
pin 22 = o1;
pin 19 = o2;
pin 16 = macro;
pin 13 = REPEAT;

o0 = (i0 $ i1);
o0.oe = i0;
o1 = ((i0 & i1) # (!i0 & !i1));
o1.oe = (!i0 & i1);
o2 = !i1;
macro = ((o2 & !i0 & i1) # (i1 & !o2 & !i0) # (i0 & o2));
REPEAT = ((i1 & o2) # (o2 & !i0));
REPEAT.oe = i0;

