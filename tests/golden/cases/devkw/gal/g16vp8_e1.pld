Name R7100; Partno R7100; Revision 01; Date 01/01/26; Designer gen; Company gen; Assembly x; Location x;
Device g16vp8;
pin 9 = !i0;
pin 6 = MACRO;
pin 12 = o0;
pin 18 = o1;
pin 16 = pinnnode;
pin 14 = o3;
pin 11 = o4;

o0 = (i0 $ MACRO);
o0.oe = i0;
o1 = ((i0 & MACRO) # (!i0 & !MACRO));
o1.oe = (!i0 & MACRO);
pinnnode = !MACRO;
o3 = ((pinnnode & !i0 & MACRO) # (MACRO & !pinnnode & !i0) # (i0 & pinnnode));
o4 = ((MACRO & pinnnode) # (pinnnode & !i0));
o4.oe = i0;

