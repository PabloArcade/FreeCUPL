o1.oe = ((not i0) and MACRO)
pinnnode = (not MACRO)
o3 = ((pinnnode and (not i0) and MACRO) or (MACRO and (not pinnnode) and (not i0)) or (i0 and pinnnode))
o4 = ((MACRO and pinnnode) or (pinnnode and (not i0)))
o4.oe = i0
*/
