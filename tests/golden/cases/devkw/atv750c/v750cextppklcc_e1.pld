/* @local */ /* @bypass */
pin 11 = !i0;
pin 7 = i1;
pin 23 = !o0;
pinnode 29 = fuse;
pin 21 = o2;

o0 = (!i1 & !i0);
o0.oe = (!i1 & i0);
fuse.t = i0;
fuse.ck = !i0;
o2 = (i0 # (fuse & !i1) # !i0);
o2.oe = i0;

