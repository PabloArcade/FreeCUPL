Device p1016pe8;
pin 1 = !a0;
pin 10 = a1;
pin 15 = !a2;
pin 17 = a3;
pin 19 = a4;
pin 26 = a5;
pin 27 = a6;
pin [9,25,22] = [q0,q1,q2];
field fa = [a2..a3];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
