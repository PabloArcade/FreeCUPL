Name G9006;
Partno P9006;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16rp6v;
/* @flags -jaxm4 */
pin [3,4,5,9] = [a0, a1, a2, !a3];
pin 1 = clk;
pin 11 = !oe;
pin 15 = s0;
pin 19 = q1;
field fa = [a0..a1];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = (a2 $ a3);
q1 = !t0;
q1.oe = !a0 & !a3;
field st = [s0];
sequenced st {
  present 1 if a1 & !a2 next 1; if !a0 & !a3 next 1;
}
