Name G9006;
Partno P9006;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16ra8;
/* @flags -jaxm3 */
pin [2,8,9] = [a0, a1, !a2];
pin [18,19] = [q0,!q1];
t0 = !(a0 & (a1 # a2 # a1) & a1 # !a2);
APPEND q0 = a1;
APPEND q0 = !a0 & a1;
q0.oe = a0 & a1;
q1.d = a2 & !t0 & !a0 # !a0 & a1 & a2;
q1.ck = a1;
q1.ar = a0 & !a1;
pin 16 = c0; pin 17 = !c1;
condition {
  if !a1 & !a2 out c1;
  default out c0;
}
