Name G9002;
Partno P9002;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16p8;
/* @flags -jaxm2 */
pin [2,3,4,6,7,8,9] = [a0, a1, !a2, a3, a4, a5, !a6];
pin 16 = q0;
pin 15 = q1;
pin 13 = !q2;
pin 12 = q3;
pin 18 = q4;
pin 17 = q5;
field fa = [a6..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = (a2 & !a5 # (a3 & !a2)) # a0 # (a0 & a2 # (a4 $ !a5) # (a6 & !a5));
t1 = !((a5 $ a6));
t2 = t0;
q0 = !t1 & !a2 # !t1 & t0 & !a3;
q1 = !a2 # a1 & a2 # t2 & a3;
q2 = [a1,a5,a3]:$;
q2.oe = a4;
q3 = [a1,a0]:#;
q4 = [a1,a4]:&;
q5 = a2 & !a6 & a1 # t2;
pin 14 = tq0;
table fa => tq0 {
  27 => 1;
  54 => 1;
  66 => 1;
  44 => 0;
}
