Name G12;
Partno P12;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20vp8ma;
/* @flags -jaxm0kb */
pin [1,7,10,11] = [in_x, in_y, !in_z, in_w];
pin 21 = !out_a;
pin 17 = out_b;
pin 14 = !out_c;
pin 22 = !out_d;
pin 19 = out_e;
pin 16 = out_f;
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
out_a = in_w # !in_y & !in_z & in_w # in_y # in_y & !in_z & !in_x;
out_b = [in_z,in_x,in_y,in_w]:&;
out_c = (in_z $ in_y);
out_c.oe = !in_x;
out_d = out_b & in_w # out_b # in_y;
!out_e = in_w & out_a # in_y & !in_x # !in_z & out_b & in_y;
out_f = in_y & !in_z # in_w & in_x & !in_z # !in_y;
out_f.oe = !in_w;
out_c.tec = in_z;
