Name G9007;
Partno P9007;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g26cv12;
pin 9 = a0;
pin 10 = !a1;
pin 11 = a2;
pin 13 = a3;
pin 28 = a4;
pin 1 = clk;
pin [25,18,15,22,20] = [s0,!s1,q2,!q3,q4];
field fa = [a1..a2];
!q2.d = (!a3 # !((a3 # a4 # !a0)) # (a2 $ a0));
q2.oe = a4;
!q3.d = !a2 # a4 & a3 # a4 & a0 & a1 # a2 & a3 & a4;
q4.d = (s0 $ !a2);
field st = [s0,s1];
sequence st {
  present 0 if a1 & a0 next 0; if !a4 next 2;
  present 2 if a1 next 0; if a0 next 2;
}
min s0.d = 2;
pin 23 = so;
condition { if st:2 out so; }
