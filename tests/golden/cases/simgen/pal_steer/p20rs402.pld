Name G9002;
Partno P9002;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20rs4mlcc;
/* @flags -jaxm3 */
pin 4 = a0;
pin 6 = a1;
pin 7 = !a2;
pin 12 = !a3;
pin [27,22,23,20,21] = [!q0,!q1,q2,q3,q4];
field fa = [a1..a2];
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
q0 = a1 & a3 # a0 # !a2 & a1 & a0;
!q1.d = !a3 # !q3 & a3 & !q0;
APPEND q2.d = a0 & q0;
APPEND q2.d = !q0;
q3 = a1;
q4.d = !((a3 & !(a3) & !(q1)));
pin 26 = !ta; pin 25 = tb;
table fa => [ta, tb] {
  'b'110 => 3;
  'b'10 => 3;
  0 => 1;
  4 => 1;
}
