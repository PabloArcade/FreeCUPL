Name G9002;
Partno P9002;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20s10mlcc;
/* @flags -jaxm0 */
pin [2,7,10,14] = [!in_x, in_y, in_z, in_w];
pin 23 = out_a;
pin 24 = out_b;
t0 = !((!(in_z) # in_y # in_y # in_x # (in_x $ in_w)));
t1 = in_x;
t2 = (!(in_z) & !t1) & (!in_y & in_w & in_y) & !(in_z) & t1 & in_w;
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
out_a = fsel(in_y, in_x, t1);
out_a.oe = !in_w & in_x;
out_b = [in_w,in_z,in_x]:$;
pin 17 = fo;
function mux2(x, y, s, flag) {
  flag = x & y;
  mux2 = x & !s # y & s;
}
fo = mux2(in_z, in_w, in_x, fflag) # fflag;
