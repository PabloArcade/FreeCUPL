Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20x8;
/* @flags -jaxm0 */
pin [2,3,7] = [a0, a1, a2];
pin 1 = clk;
pin [16,18,15,22,17] = [!q0,!q1,!q2,!q3,q4];
field fa = [a0..a2];
q0.d = !q2 & a2;
q1.d = !a1;
APPEND q2.d = a0;
APPEND q3.d = a0;
APPEND q3.d = a0;
q4.d = a0 & a2 & !a1 # a1 & a0;
min q4.d = 4;
