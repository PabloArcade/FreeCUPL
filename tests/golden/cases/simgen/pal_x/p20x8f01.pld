Name G9012;
Partno P9012;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20x8;
/* @flags -jaxkb */
pin [4,5,7,9,10] = [a0, !a1, a2, a3, !a4];
pin 1 = clk;
pin 18 = !q0;
pin 21 = q1;
field fa = [a2..0];
q0.d = fa:'h'E;
APPEND q1.d = q0 & !a3;
APPEND q1.d = !a2;
pin 14 = c0; pin 23 = !c1;
condition {
  if !a2 out [c0, c1];
  if a4 out c0;
  if a0 & a4 out c0;
  default out c1;
}
