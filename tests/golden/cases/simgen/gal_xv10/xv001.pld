Name G9002;
Partno P9002;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Device g20xv10;
/* @flags -jaxkb */
pin [2,4,7] = [in_x, in_y, in_z];
pin 1 = clk;
pin 17 = !out_a;
pin 23 = !out_b;
pin 22 = out_c;
pin 14 = out_d;
pin 20 = !out_e;
pin 19 = out_f;
out_a.d = in_z;
out_b = [in_y,in_z,in_x]:#;
out_c.d = in_y & in_y & in_y & (!in_y & in_y);
out_c.oe = !in_y & in_x;
out_d.d = [in_x,in_z]:$;
out_e.d = ((in_z # !in_z # !in_y) # in_x # (in_x $ !in_z));
!out_f.d = [in_x,in_y]:#;
pin 16 = fo;
function mux2(x, y, s, flag) {
  flag = x & y;
  mux2 = x & !s # y & s;
}
fo = mux2(in_z, in_x, in_y, fflag) # fflag;
