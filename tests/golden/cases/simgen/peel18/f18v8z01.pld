Name G9007;
Partno P9007;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device f18v8zs;
/* @flags -jaxm3 */
pin [1,2,4,6,7,8,11] = [a0, a1, a2, a3, a4, !a5, a6];
pin 14 = !q0;
pin 13 = q1;
field fa = [a2..a4];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
!q0 = OFF & a0 # OFF;
q1 = a3;
q1.oe = a4 & a2;
min q0 = 2;
pin 18 = c0; pin 16 = !c1;
condition {
  if a1 out c0;
  if a3 out [c0, c1];
  default out c0;
}
