Name P; Partno 0; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 1 = clk; pin 2 = a0; pin 3 = a1;
pin 23 = s2;
pin 22 = !s0;
pin 21 = !zz;
field st = [s2,s0,zz];
sequence st {
  present 4 if a0 & !a1 next 1; default next 1;
  present 1 if a0 & !a1 next 4; default next 4;
}
