Name P; Partno 0; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 1 = clk; pin 2 = a0; pin 3 = a1;
pin 23 = ww;
pin 22 = s3;
pin 21 = zz;
pin 20 = s0;
field st = [ww,s3,zz,s0];
sequencet st {
  present 7 if a0 & !a1 next 1; default next 2;
  present 8 next 8;
  present 1 if a0 & !a1 next 2; default next 8;
  present 2 if a0 & !a1 next 2; default next 4;
  present 4 if a0 & !a1 next 1; default next 7;
}
