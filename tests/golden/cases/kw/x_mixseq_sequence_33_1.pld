Name P; Partno 0; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 1 = clk; pin 2 = a0; pin 3 = a1;
pin 23 = !zz;
pin 22 = s1;
pin 21 = s2;
pin 19 = y;
field st = [zz,s1,s2];
sequence st {
  present 6 if a0 & !a1 next 0; default next 7;
  present 1 next 1;
  present 3 if a1 next 0 out y;
  present 0 if a0 & !a1 next 1; default next 6;
  present 7 next 7;
}
