Name P; Partno 0; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 1 = clk; pin 2 = a0; pin 3 = a1;
pin 23 = s2;
pin 22 = !s0;
pin 21 = zz;
field st = [s2,s0,zz];
sequenced st {
  present 6 next 4;
  present 4 if a0 & !a1 next 4; default next 6;
  present 0 if a0 & !a1 next 3; default next 0;
  present 3 if a0 & !a1 next 0; default next 3;
}
