Name P; Partno 0; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 1 = clk; pin 2 = a0; pin 3 = a1;
pin 23 = !zz;
pin 22 = s1;
pin 21 = s2;
field st = [zz,s1,s2];
sequencet st {
  present 0 next 3;
  present 3 next 0;
  present 7 if a0 & !a1 next 7; default next 3;
}
