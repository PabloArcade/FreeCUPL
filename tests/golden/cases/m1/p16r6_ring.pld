Name p16r6_ri; Partno P16R6_RI; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device p16r6;
pin 2 = a;
pin 3 = b;
pin 13 = r0;
pin 14 = !r1;
pin 15 = r2;
pin 16 = !r3;
pin 17 = r4;
pin 18 = !r5;
pin 12 = x;

r0.d = a & !r5 # x;
r1.d = r0 $ b;
r2.d = r1 $ b;
r3.d = r2 $ b;
r4.d = r3 $ b;
r5.d = r4 $ b;

/* @expect
r0.d = a and not r5 or x
r1.d = r0 ^ b
r2.d = r1 ^ b
r3.d = r2 ^ b
r4.d = r3 ^ b
r5.d = r4 ^ b
*/
