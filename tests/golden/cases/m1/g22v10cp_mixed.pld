Name g22v10cp; Partno G22V10CP; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10cp;
pin 2 = a;
pin 3 = b;
pin 5 = oe;
pin 18 = !r;
pin 17 = s;
pin 16 = y;
pin 15 = !t;

r.d = a & !s # b & s;
s.d = r;
s.oe = oe;
y = r & s;
t = r # a;

