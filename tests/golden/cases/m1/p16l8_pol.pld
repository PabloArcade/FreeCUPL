Name p16l8_po; Partno P16L8_PO; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device p16l8;
pin 1 = !a;
pin 2 = b;
pin 3 = !c;
pin 13 = o0;
pin 14 = !o1;
pin 15 = o2;
pin 16 = !o3;
pin 17 = o4;
