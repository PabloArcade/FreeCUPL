Name g20v8a_a; Partno G20V8A_A; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g20v8a;
pin 2 = en;
pin 22 = q0;
pin 21 = !q1;
pin 20 = q2;
pin 19 = !y;
pin 18 = x;

q0.d = q0 $ en;
q1.d = q1 $ (q0 & en);
q2.d = q2 $ (q1 & q0 & en);
y = q0 & q1 & x;
y.oe = q2;

