Name g20v8a_a; Partno G20V8A_A; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g20v8a;
pin 1 = a;
pin 2 = b;
pin 13 = en;
pin 21 = x;
pin 22 = y;
pin 20 = !z;
pin 15 = w;

y = a & x;
y.oe = en;
z = !x # b;
z.oe = !en;
w = a & !b & !x
    # !a & b & !x
    # !a & !b & x
    # a & b & x;

/* @expect
y = a and x
y.oe = en
z = not x or b
z.oe = not en
w = (a and not b and not x)
    or (not a and b and not x)
    or (not a and not b and x)
    or (a and b and x)
*/
