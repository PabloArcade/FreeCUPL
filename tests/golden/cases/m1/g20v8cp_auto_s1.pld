pin 1 = a;
pin 2 = b;
pin 5 = c;
pin 13 = d;
pin 22 = y;
pin 21 = !z;
pin 15 = w;
pin 20 = !t;

y = a & b # !d;
z = c $ d;
w = a & !b & !c & !d
    # !a & b & !c & !d
    # !a & !b & c & !d
    # a & b & c & !d
    # !a & !b & !c & d
    # a & b & !c & d
    # a & !b & c & d
    # !a & b & c & d;
t = 'b'1;

