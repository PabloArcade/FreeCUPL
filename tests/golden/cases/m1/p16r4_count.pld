Name p16r4_co; Partno P16R4_CO; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device p16r4;
pin 2 = en;
pin 14 = q0;
pin 15 = !q1;
pin 16 = q2;

q0.d = q0 $ en;
q1.d = q1 $ (q0 & en);
q2.d = q2 $ (q1 & q0 & en);

