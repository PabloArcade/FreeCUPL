Name g16v8ma_; Partno G16V8MA_; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g16v8ma;
pin 2 = a;
pin 3 = b;
pin 4 = c;
pin 5 = d;
pin 18 = !y1;
pin 17 = y2;
pin 16 = y3;

y1 = !a & !b & !c & !d
    # a & b & !c & !d
    # a & !b & c & !d
    # !a & b & c & !d
    # a & !b & !c & d
    # !a & b & !c & d
    # !a & !b & c & d;
y2 = y1 & c;
y3 = !y2;

/* @expect
y1 = (not a and not b and not c and not d)
