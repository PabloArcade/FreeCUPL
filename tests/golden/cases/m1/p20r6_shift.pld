Name p20r6_sh; Partno P20R6_SH; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device p20r6;
pin 2 = din;
pin 3 = ld;
pin 4 = d1;
pin 16 = s0;
pin 17 = s1;
pin 18 = !s2;
pin 19 = s3;

s0.d = din;
s1.d = ld & d1 # !ld & s0;
s2.d = s1;
s3.d = !s2 # din & d1;

