Name g22v10_c; Partno G22V10_C; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g22v10;
pin 2 = en;
pin 3 = rst;
pin 4 = pre;
pin 23 = q0;
pin 22 = !q1;
pin 21 = q2;
pin 20 = !q3;

q0.d = q0 $ en;
q1.d = q1 $ (q0 & en);
q2.d = q2 $ (q1 & q0 & en);
q3.d = q3 $ (q2 & q1 & q0 & en);
q0.ar = rst;
q1.ar = rst;
q2.ar = rst;
q3.ar = rst;
q0.sp = pre;
q1.sp = pre;
q2.sp = pre;
q3.sp = pre;

