Name g20v8ms_; Partno G20V8MS_; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device g20v8ms;
pin 2 = a;
pin 3 = b;
pin 4 = c;
pin 15 = !r;
pin 16 = s;
pin 22 = y;

r.d = a & !b & !c
    # !a & b & !c
    # !a & !b & c
    # a & b & c # s;
s.d = !r;
y = r $ s;

