Name p20r4_ri; Partno P20R4_RI; Revision 01; Date 01/01/26; Designer x; Company x; Assembly x; Location x;
Device p20r4;
pin 2 = a;
pin 3 = b;
pin 17 = r0;
pin 18 = !r1;
pin 19 = r2;
pin 20 = !r3;
pin 15 = x;

r0.d = a & !r3 # x;
r1.d = r0 $ b;
r2.d = r1 $ b;
r3.d = r2 $ b;

/* @expect
r0.d = a and not r3 or x
r1.d = r0 ^ b
r2.d = r1 ^ b
