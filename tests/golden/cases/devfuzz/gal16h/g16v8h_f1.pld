Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8h;
/* @flags -jaxm3 */
pin [5,6,7] = [a0, a1, !a2];
pin 1 = clk;
pin 23 = q0;
field fa = [a2..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = !(((a0 # !a1 # !a0) & (!a1 & !a1 & a0) & !a2));
t1 = (t0 $ !a1);
condition {
  if a1 out q0;
  default out q0;
}
