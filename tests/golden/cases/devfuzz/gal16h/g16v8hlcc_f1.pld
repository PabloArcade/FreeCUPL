Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8hlcc;
/* @flags -jaxf */
pin 5 = a0;
pin 7 = a1;
pin 9 = a2;
pin 10 = a3;
pin 11 = a4;
pin 2 = clk;
pin [27,23,19] = [q0,!q1,!q2];
field fa = [a0..a1];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = (a4 & (a3 $ a4) & a3 # a1 & !(a0) & !a3 # a0);
t1 = !t0 # (t0 $ a3);
t2 = ((a0 # t0 # !a0) # !(!a2 & t0));
q0 = a3 & !((t2 & a1)) & a4;
!q1 = !a2;
!q2 = t1 & !a2 & t2 # a4 & !a2 & t1 # a1 # !a2 & !t2;
pin 17 = tq0;
table fa => tq0 {
  0 => 1;
  3 => 0;
  2 => 1;
  1 => 0;
}
