Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16v8hslcc;
pin 2 = !in_x;
pin 3 = in_y;
pin 5 = in_z;
pin 6 = in_w;
pin 7 = in_v;
pin 18 = !out_a;
pin 27 = !out_b;
t0 = (!in_y # (in_v # in_y) # (in_y & in_y & in_y) # (in_w & !(in_v)) # (!in_z & (in_y # in_x # !in_v) & (in_x & in_y)));
APPEND out_a = t0;
APPEND out_a = !t0;
condition {
  if !in_w out out_b;
  default out out_b;
}
pin 16 = fo;
function mux2(x, y, s, flag) {
  flag = x & y;
  mux2 = x & !s # y & s;
}
fo = mux2(in_w, in_z, in_x, fflag) # fflag;
