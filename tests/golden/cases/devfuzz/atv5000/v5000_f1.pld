Name G9001;
Partno P9001;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device v5000;
/* @flags -jaxkb */
pin [2,35,66] = [!a0, !a1, a2];
pinnode 112 = q0;
pin 23 = q1;
pinnode 107 = q2;
field fa = [a1..0];
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
q0.t = a1;
q1.d = !a2;
q1.oe = 'b'1;
q2.d = a2;
pin 22 = tq0;
table fa => tq0 {
  0 => 0;
  1 => 1;
  2 => 1;
  3 => 1;
}
pin 22 = c0; pin 25 = !c1;
condition {
  if !a0 out c1;
  if !a2 out c1;
  default out c1;
}
