Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16z8ms;
pin 3 = a0;
pin 5 = a1;
pin 7 = a2;
pin 17 = q0;
field fa = [a1..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = !((a1 & a2 & a1 & (!a0 & a0 & a0) & a1));
t1 = (!(!a1) & !((a2 & a1)) & t0 & a2 # a2 # a1);
t2 = (t0 & !(!(!a2)) & a1);
q0.d = !a0 & a1 & t2;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%3};
$REPEND
