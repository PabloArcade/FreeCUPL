Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16z8ma;
pin 3 = a0;
pin 5 = a1;
pin 6 = !a2;
pin 10 = a3;
pin 13 = !a4;
pin 1 = clk;
pin 22 = q0;
pin 20 = q1;
field fa = [a2..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
!q0 = a4;
APPEND q1 = a0 & a4;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%5};
$REPEND
