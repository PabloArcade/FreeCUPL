Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device f16v8;
pin 2 = !a0;
pin 4 = !a1;
pin 8 = a2;
pin 1 = clk;
pin 11 = !oe;
pin [12,15,13] = [q0,q1,q2];
field fa = [a0..a1];
t0 = a2;
t1 = (!a0 # (!a2 & !t0 & a0)) & (a0 $ a1);
q0.d = 'h'1 # (t0 # q2 # (t1 # !t1 # !a2)) # !t1;
q1 = !a0;
q1.oe = a1 & a0;
q2.d = (t0 $ !q0);
pin 18 = fo;
function mux2(x, y, s, flag) {
  flag = x & y;
  mux2 = x & !s # y & s;
}
fo = mux2(a0, a1, a2, fflag) # fflag;
