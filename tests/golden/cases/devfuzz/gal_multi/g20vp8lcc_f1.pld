Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20vp8lcc;
pin [4,5,25] = [in_x, in_y, in_z];
pin 23 = clk;
pin 16 = out_a;
pin 10 = out_b;
pin 18 = out_c;
APPEND out_a = in_x & !in_z;
APPEND out_a = in_x & in_z;
out_b.d = ((in_y $ in_x) # (in_z $ in_x) # in_x);
out_c.d = ((in_z $ in_y) & !(in_x));
