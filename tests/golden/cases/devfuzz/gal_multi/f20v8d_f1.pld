Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device f20v8d;
/* @flags -jaxm0kb */
pin 2 = a0;
pin 3 = !a1;
pin 4 = a2;
pin 5 = a3;
pin 7 = a4;
pin 9 = a5;
pin 11 = a6;
pin 13 = !oe;
pin 17 = q0;
pin 21 = q1;
pin 20 = q2;
pin 22 = q3;
pin 16 = q4;
field fa = [a0..a2];
!q0 = a0 & !a2 # !a6 & a4 & !a3 # !a6 # !a5 & a0;
q1 = !((a4 # !a2) # !a1 & a6);
q2 = a1 & a2 & q1 # !a5;
APPEND q3.d = q2;
q4 = !a0 & a5 & !a2 # a6 & a1 & !a2 # a4 & a0 & a3;
q4.oe = 'b'1;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%7};
$REPEND
