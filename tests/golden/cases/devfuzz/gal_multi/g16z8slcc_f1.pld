Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g16z8slcc;
/* @flags -jaxm3 */
pin [4,5,7,11,16] = [a0, a1, a2, a3, a4];
pin 2 = clk;
pin [18,24,20,25] = [q0,q1,!q2,q3];
field fa = [a0..a2];
t0 = !((a3 & a0 & (a4 & a0 & !a1) & (a1 & a1 & a1)));
t1 = !(a0);
t2 = (!t1 & (a2 # a3) & !(!a3)) & t0 & a0;
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
!q1 = fa:5;
!q2 = !(!(a1 & a4 & a2));
q3 = a1 & t0 # a0 & !a4 & !t1 # !a4 # a4 & !a0 & !a3;
condition {
  if !a2 out q0;
  default out q0;
}
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
$DEFINE AND &
$DEFINE OR #
pin 21 = dq;
dq = a2 AND a1 OR !a4;
