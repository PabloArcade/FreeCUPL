Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16r4alcc;
pin [2,3,4,5,25,27,28] = [in_x, in_y, in_z, !in_w, in_v, in_u, in_t];
pin 16 = !out_a;
pin 18 = out_b;
pin 12 = out_c;
pin 10 = out_d;
pin 8 = out_e;
pin 14 = out_f;
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
t0 = ((in_u $ in_w) & !(in_u) & !in_z & !in_y # (in_v $ !in_z) # !(in_t));
t1 = (((in_z $ in_y) & (t0 # t0) & !(in_t)) & (in_z $ in_w) # in_y # !in_y # !in_v # (t0 & in_u) & in_z);
!out_a.d = !in_w;
out_b.d = (!(in_x) & in_t # !in_t # in_z & !in_w # !in_y # in_u) # 'h'1;
out_c.d = [in_v,in_t,in_z,in_x]:#;
out_e = !in_u & t0 & !in_z # !t1 & !in_z # t1;
APPEND out_f.d = t1 & !t0;
APPEND out_f.d = !in_w;
condition {
  if !in_z out out_d;
}
