Device p20r4lcc;
pin 3 = !in_x;
pin 9 = in_y;
pin 10 = in_z;
pin 16 = !oe;
pin 24 = out_a;
pin 23 = out_b;
pin 18 = out_c;
out_a.d = ((!in_y & in_z) # (!in_x # !in_x) # (!in_z # !in_z)) $ (in_z # in_y # (in_z # !in_x # in_x) # in_x);
out_b.d = (!in_x # in_z # out_a) # !(in_x) & ((!in_z & in_y) # !(out_a)) & in_x;
out_c = (in_z # in_y # in_x) & !in_x & !in_y & !in_x # (in_z & !in_x & in_x) # in_x & !in_x & in_x & !in_x;
out_c.oe = in_x & !in_z;
