Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8malcc;
pin [2,3,11,17,27] = [!a0, a1, !a2, a3, a4];
pin 18 = q0;
field fa = [a0..a1];
t0 = a3;
t1 = !(a2 & a2 & a2) # (a3 $ t0);
t2 = (!((a3 $ t1)) # (a4 $ t1) # !t1);
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0 = fsel(a1, a4, a2);
q0.oe = a2;
$MACRO AND2 x y z
x = y & z;
$MEND
AND2(mv, a0, a1)
pin 26 = c0; pin 23 = !c1;
condition {
  if a4 & a1 out c1;
  if !a0 & a4 out c1;
}
