Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20r6lcc;
/* @flags -jaxm3 */
pin 3 = !a0;
pin 5 = !a1;
pin 6 = !a2;
pin 7 = a3;
pin 9 = a4;
pin 10 = a5;
pin 27 = !a6;
pin 2 = clk;
pin 16 = !oe;
pin 25 = q0;
pin 24 = q1;
pin 26 = q2;
field fa = [a0..a2];
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
t0 = (!(a2 & a1) & ((a0 & a1 & !a3) & a3 & !a4 & !a2) & (a4 & !(a4) & !a2));
t1 = a1;
t2 = !a3;
!q0.d = a0;
q1.d = a0;
q2 = a2 & !t2 & !a4 # !a1 # !a6 # t0;
q2.oe = !a3;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%7};
$REPEND
