Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8slcc;
/* @flags -jaxm2 */
pin [3,6,13,27] = [a0, a1, !a2, a3];
pin 2 = clk;
pin [26,25] = [q0,q1];
field fa = [a0..a1];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = a2;
t1 = !(!t0) # (!a0 & a3 & a3) # t0 & a3 & t0 & a0 & t0 & !t0 # !a2 # !a0 # !t0;
q0 = ((t0 $ t1) # ((t0 $ !a2) # (!t0 # a3 # a3) # !t1));
q1 = a0 & (t0 $ !a1) & a0;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%4};
$REPEND
