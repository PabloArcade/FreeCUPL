Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16l8alcc;
/* @flags -jaxf */
pin 26 = a0;
pin 27 = a1;
pin 28 = a2;
pin [20,10] = [!q0,!q1];
field fa = [a0..a2];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
t0 = !((!a2 & (a1 & a0 & a1)));
t1 = (!(!t0) & !a0 & (!a1 # a0)) & a0;
q0 = a1 & !a2 # !t0;
q1 = !a2;
