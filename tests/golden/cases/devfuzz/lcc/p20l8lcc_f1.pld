Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p20l8lcc;
/* @flags -jaxm2 */
pin 4 = a0;
pin 7 = a1;
pin 9 = a2;
pin 12 = !a3;
pin [25,19,21,18,24] = [q0,!q1,q2,q3,q4];
field fa = [a3..0];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
APPEND q0 = a2 & !q1;
APPEND q0 = a2;
q1 = ((!a1 # (!a3 & !a1 & !a3)) & (a3 # !a2) # !a1 # !a0 # !a0);
q2 = OFF & a0 # OFF;
q2.oe = 'b'1;
!q3 = a2 & !q4 # !a2 & !a1 & a3 # !q4 & q0 & q1 # a2 & !a3;
q4 = a3 # ((a2 & a1 & a0) # 'b'0 # !(!a3));
pin 23 = tq0;
table fa => tq0 {
  7 => 0;
  0 => 0;
  3 => 1;
  2 => 1;
}
pin 23 = !ta; pin 26 = tb;
table fa => [ta, tb] {
  0 => 1;
  D => 3;
}
