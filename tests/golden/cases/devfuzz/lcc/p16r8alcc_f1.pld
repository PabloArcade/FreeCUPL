Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device p16r8alcc;
pin 3 = !a0;
pin 4 = a1;
pin 25 = a2;
pin 26 = a3;
pin 27 = a4;
pin [20,14,18] = [s0,q1,q2];
field fa = [a0..a1];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
t0 = (a0 # !a1 # !((!a2 # !a3)));
q2.d = [a0,a2,a1]:#;
field st = [s0];
sequence st {
  present 0 if a1 next 0 out q1;
}
