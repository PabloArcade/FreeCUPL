Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8mslcc;
pin 3 = a0;
pin 4 = a1;
pin 6 = a2;
pin 11 = a3;
pin 17 = a4;
pin 20 = q0;
pin 26 = !q1;
field fa = [a2..0];
t0 = a2;
q0.d = ((!(t0) # !(a1)) & (a3 & !(a4)) & (!a2 & (a1 # a0 # !a4) & a0 & t0));
q1.d = t0 & a3 & a1 # !t0 # t0 # !a1 & a0 & a3;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%5};
$REPEND
