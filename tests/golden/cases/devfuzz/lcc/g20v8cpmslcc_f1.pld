Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20v8cpmslcc;

pin [11,12,17] = [a0, !a1, a2];
pin 16 = !oe;
pin 19 = !q0;
pin 24 = q1;
pin 18 = q2;
pin 23 = !q3;
field fa = [a0..a2];
function fsel(x, y, s) {
  fsel = x & s # y & !s;
}
q0.d = a2 & a1;
!q1.d = !q2 # q0 # q0 # a2 & a0 & q2;
q2.d = !a1;
APPEND q3.d = a2 & a1;
APPEND q3.d = !a0 & q2;
pin 25 = tq0;
table fa => tq0 {
  4 => 1;
  3 => 0;
  0 => 1;
  6 => 1;
}
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%3};
$REPEND
