Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20xv10ilcc;
pin [2,3,6,7,10] = [a0, a1, !a2, a3, !a4];
pin 2 = clk;
pin 17 = !q0;
pin 25 = q1;
pin 23 = !q2;
pin 27 = !q3;
pin 18 = !q4;
pin 20 = q5;
field fa = [a4..1];
t0 = (a1 & (a2 # a1 # !(a1)) & (a3 $ a2));
t1 = (a0 $ a1);
t2 = a4 # t0 & !t1 # !(t0) # t1 # !a4;
q0.d = fa:[E..1B];
q1.d = a0;
q2 = (t2 # ((a0 $ !a4) # a3));
q3 = !(!t2) # !((!t0 # !t0 # t2));
q4 = a4 & !a3 & a2 # a1 & !a0 & !t1 # a2;
q5.d = a3 & !a0 & a1 # !q4 # t2;
$REPEAT i = [0..2]
rv{i} = a{i} & a{(i+1)%5};
$REPEND
