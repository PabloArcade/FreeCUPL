Name G9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20xv10lcc;
/* @flags -jaxm2 */
pin 2 = a0;
pin 3 = a1;
pin 4 = !a2;
pin 5 = a3;
pin 6 = !a4;
pin 12 = a5;
pin 2 = clk;
pin [18,27,24,21] = [!q0,q1,q2,q3];
field fa = [a0..a3];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
q0 = !a4 & a2 & a5 # !a4 & !a5 & !a1 # !a4 & a2 & !a3;
q0.oe = 'b'1;
q1 = a3 # !a4;
q2.d = (((a2 $ a1) & a0 & !(a0)) & q3);
q3.d = a5 & q2 & !a1 # a1 # !a5 & !a0;
pin 20 = tq0;
table fa => tq0 {
  D => 1;
  3 => 0;
  E => 1;
  5 => 1;
}
