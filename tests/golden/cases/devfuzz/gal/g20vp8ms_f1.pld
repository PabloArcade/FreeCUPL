Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Company gen;
Assembly x;
Location x;
Device g20vp8ms;
/* @flags -jaxkb */
pin 3 = a0;
pin 5 = !a1;
pin 7 = !a2;
pin 13 = a3;
pin 24 = a4;
pin 22 = q0;
pin 21 = q1;
pin 14 = q2;
pin 20 = q3;
field fa = [a0..a3];
t0 = (!a2 $ (!a2 & (a1 $ !a4)) $ a4);
t1 = (a1 & a0 & a1);
q0.d = !(a1 # !t1 & !(a3) & !a3 # !a0 # !t0);
APPEND q1.d = q0 & !q3;
APPEND q1.d = t0 & t1;
condition {
  if a4 out q2;
  if !a2 out q3;
  default out q2;
}
