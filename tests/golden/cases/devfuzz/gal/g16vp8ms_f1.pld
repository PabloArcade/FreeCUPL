Name G9001;
Partno P9001;
Revision 01;
Date 01/01/26;
Designer gen;
Assembly x;
Location x;
Device g16vp8ms;
/* @flags -jaxkb */
pin [3,6,7,8,9,20] = [a0, a1, !a2, a3, a4, !a5];
pin 1 = clk;
pin 19 = s0;
field fa = [a0..a5];
$DEFINE ON 'b'1
$DEFINE OFF 'b'0
$DEFINE NEVER_USED_FLAG X
$IFDEF NEVER_USED_FLAG
/* conditional block */
$ELSE
this is not compiled ;
$ENDIF
t0 = a4;
field st = [s0];
sequence st {
  present 0 next 0;
  present 1 if a3 & a1 next 0; if a1 next 0;
}
